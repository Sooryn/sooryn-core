# ============================
#  Sooryn System Font
# ============================
# A web page that names no font still reads smoothly: the browser draws it in
# the platform's interface typeface (`system-ui`). Sooryn does the same. A
# windowed application gets the platform's UI font by default, built at the
# display's pixel size, and falls back to the built-in face only on a machine
# that has none of the known ones.
#
# Headless applications keep the built-in face by default. Tests compare
# pixels and widths, and those must not change with the fonts a machine
# happens to have installed. use_system_font() opts a headless app in.

SOORYN_FONT_SYSTEM: i32 = 1
SOORYN_FONT_BUILTIN: i32 = 2

# The size a default face is built at, in logical units.
SOORYN_DEFAULT_TEXT_SIZE: i32 = 14

# Interface fonts in preference order. Only TrueType outlines (glyf) are
# listed: CFF-flavoured .otf files are not read by the fonts package.
fun sooryn_system_font_candidates() -> list<str>:
    candidates: list<str> = []
    if Str.equals(PlatformInfo.name(), "windows"):
        windows: str = PlatformHost.get_environment("WINDIR")
        if Memory.strlen(windows) == 0:
            windows = "C:/Windows"
        fonts: str = PathOps.join_path(windows, "Fonts")
        candidates.append(PathOps.join_path(fonts, "segoeui.ttf"))
        candidates.append(PathOps.join_path(fonts, "tahoma.ttf"))
        candidates.append(PathOps.join_path(fonts, "arial.ttf"))
        return candidates
    candidates.append("/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf")
    candidates.append("/usr/share/fonts/noto/NotoSans-Regular.ttf")
    candidates.append("/usr/share/fonts/google-noto/NotoSans-Regular.ttf")
    candidates.append("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
    candidates.append("/usr/share/fonts/TTF/DejaVuSans.ttf")
    candidates.append("/usr/share/fonts/dejavu/DejaVuSans.ttf")
    candidates.append("/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf")
    candidates.append("/usr/share/fonts/truetype/ubuntu/Ubuntu-R.ttf")
    candidates.append("/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf")
    candidates.append("/usr/share/fonts/liberation-sans/LiberationSans-Regular.ttf")
    candidates.append("/usr/share/fonts/truetype/freefont/FreeSans.ttf")
    return candidates

attach SoorynApp:
    # Let Sooryn pick the face again: the platform's interface font, rebuilt
    # at every display scale. Returns 1 when a system font was found.
    fun use_system_font(self) -> i32:
        self.default_font_kind = SOORYN_FONT_SYSTEM
        self.uses_default_font = 1
        self.apply_default_font()
        if self.system_font_state == 1:
            return 1
        return 0

    # The pixel face built into the ui package, at the display's size.
    fun use_builtin_font(self):
        self.default_font_kind = SOORYN_FONT_BUILTIN
        self.uses_default_font = 1
        self.apply_default_font()

    # Where the default face came from: a font file, or "" for the built-in.
    fun default_font_source(self) -> str:
        if self.uses_default_font == 1 and self.default_font_kind == SOORYN_FONT_SYSTEM and self.system_font_state == 1:
            return self.system_font_path
        return ""

    # The file is read once and kept: a display-scale change rebuilds the
    # face from memory instead of going back to the disk.
    fun load_system_font_bytes(self) -> i32:
        if self.system_font_state != 0:
            if self.system_font_state == 1:
                return 1
            return 0
        self.system_font_state = 2
        candidates: list<str> = sooryn_system_font_candidates()
        index: i64 = 0
        while index < candidates.size():
            path: str = candidates.get_str(index)
            if PathOps.exists(path):
                bytes: DpkBytes = dpk_read_file(path)
                if bytes.ok == 1:
                    # Parsing the tables is enough to know the file is a
                    # TrueType font this package reads; building a face here
                    # would double the cost of opening the application.
                    info: TtfInfo = ttf_parse(bytes.data, bytes.size)
                    if info.valid == 1:
                        self.system_font_bytes = bytes.data
                        self.system_font_size = bytes.size
                        self.system_font_path = path
                        self.system_font_state = 1
                        return 1
                    bytes.free()
            index = index + 1
        return 0

    # Build the default face at the current display scale and hand it to
    # the surface, which owns it from then on.
    fun apply_default_font(self):
        if self.uses_default_font == 0:
            return
        pixels: i32 = self.to_physical(SOORYN_DEFAULT_TEXT_SIZE)
        if self.default_font_kind == SOORYN_FONT_SYSTEM and self.load_system_font_bytes() == 1:
            face: FontFace = font_face_from_ttf_bytes(self.system_font_bytes, self.system_font_size, pixels)
            if face.is_valid() == 1:
                self.surface.adopt_font_face(face)
                return
        self.surface.use_default_font(pixels)

    fun _free_system_font(self):
        if self.system_font_bytes != 0:
            Memory.free(self.system_font_bytes)
        self.system_font_bytes = 0
        self.system_font_size = 0
        self.system_font_state = 0
