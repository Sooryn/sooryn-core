# ============================
#  Sooryn Text Editing
# ============================
# A caret and a selection for single-line text input.
#
# Only one input can hold keyboard focus, so one set of caret state serves
# every input in the application; text_owner records whose it currently is.
# That keeps the caller's contract unchanged — an input is still just a byte
# buffer and a maximum length — while giving the widget a real editing model
# instead of append-and-backspace.
#
# The selection is the span between anchor and caret, in either order. An
# empty selection means anchor and caret sit together.
#
# Positions are byte offsets into the UTF-8 buffer, and the caret only ever
# rests between whole characters, as a browser's does:
#
# - the arrow keys and Delete step over a whole character as the reader sees
#   it: a letter with its accents or harakat, an emoji with its skin tone or
#   its zero-width-joined parts, a flag;
# - Backspace removes one code point, as Chrome does, so a harakah or an
#   accent typed by mistake goes without its letter, while an emoji or a
#   flag still goes whole.

attach SoorynApp:
    # Length of the NUL-terminated buffer, bounded by max_len.
    fun text_length(self, buf: i64, max_len: i32) -> i32:
        n: i32 = 0
        b: i8 = 0 as i8
        while n < max_len:
            b = Memory.read_i8(buf + (n as i64))
            if b == 0:
                return n
            n = n + 1
        return n

    # Width of the first `count` bytes. Measured through the active face by
    # borrowing the buffer's own terminator, so no allocation is needed.
    fun text_prefix_width(self, buf: i64, count: i32) -> i32:
        if count <= 0:
            return 0
        at: i64 = buf + (count as i64)
        saved: i8 = Memory.read_i8(at)
        Memory.write_i8(at, 0 as i8)
        width: i32 = self.text_width(buf as str)
        Memory.write_i8(at, saved)
        return width

    # Byte offset nearest to a pixel position, snapping to whichever side of
    # the glyph the pointer is closer to.
    fun text_index_at(self, buf: i64, length: i32, text_x: i32, target_x: i32) -> i32:
        if target_x <= text_x:
            return 0
        best: i32 = 0
        i: i32 = 0
        while i <= length:
            if text_x + self.text_prefix_width(buf, i) <= target_x:
                best = i
            i = i + 1
        if best < length:
            near: i32 = target_x - (text_x + self.text_prefix_width(buf, best))
            far: i32 = (text_x + self.text_prefix_width(buf, best + 1)) - target_x
            if near > far:
                best = best + 1
        return best

    # ---------------------------------------------------------------
    # Selection
    # ---------------------------------------------------------------
    fun text_has_selection(self) -> i32:
        if self.text_caret == self.text_anchor:
            return 0
        return 1

    fun text_sel_start(self) -> i32:
        if self.text_caret < self.text_anchor:
            return self.text_caret
        return self.text_anchor

    fun text_sel_end(self) -> i32:
        if self.text_caret > self.text_anchor:
            return self.text_caret
        return self.text_anchor

    fun text_select_all(self, length: i32):
        self.text_anchor = 0
        self.text_caret = length

    # Take the caret when focus arrives, and keep it inside the buffer when
    # the application edits it behind the widget's back.
    fun text_claim(self, id: i64, length: i32):
        if self.text_owner == id:
            if self.text_caret > length:
                self.text_caret = length
            if self.text_anchor > length:
                self.text_anchor = length
            return
        self.text_owner = id
        self.text_caret = length
        self.text_anchor = length
        self.text_dragging = 0

    fun text_move_caret(self, position: i32, extend: i32, length: i32):
        p: i32 = position
        if p < 0:
            p = 0
        if p > length:
            p = length
        self.text_caret = p
        if extend == 0:
            self.text_anchor = p

    # ---------------------------------------------------------------
    # Characters as the reader sees them
    # ---------------------------------------------------------------
    # The code point at a byte offset (size 0 past the end).
    fun _text_code_at(self, buf: i64, length: i32, position: i32) -> Utf8Char:
        if position >= length:
            return Utf8Char()
        return utf8_decode(buf, position as i64, length as i64)

    # Where the code point that ends at `position` starts.
    fun text_prev_code_point(self, buf: i64, position: i32) -> i32:
        p: i32 = position - 1
        while p > 0 and (Memory.read_i8(buf + (p as i64)) & 192) == 128:
            p = p - 1
        if p < 0:
            return 0
        return p

    # The end of the character that starts at `position`: past every mark,
    # selector and modifier that attaches to it, through zero-width joins,
    # and over both halves of a flag.
    fun text_next_cluster(self, buf: i64, length: i32, position: i32) -> i32:
        if position >= length:
            return length
        first: Utf8Char = self._text_code_at(buf, length, position)
        if first.size <= 0:
            return position + 1
        p: i32 = position + first.size
        previous: i32 = first.codepoint
        flags: i32 = 0
        if sooryn_is_regional_indicator(first.codepoint) == 1:
            flags = 1
        while p < length:
            following: Utf8Char = self._text_code_at(buf, length, p)
            if following.size <= 0:
                return p
            joins: i32 = 0
            if sooryn_extends_cluster(following.codepoint) == 1:
                joins = 1
            elif previous == 8205:
                # After a zero-width joiner the next picture is the same
                # character (a family, a profession with a skin tone).
                joins = 1
            elif flags == 1 and sooryn_is_regional_indicator(following.codepoint) == 1:
                joins = 1
                flags = 2
            if joins == 0:
                return p
            p = p + following.size
            previous = following.codepoint
        return length

    # The start of the character that ends at `position`. Single-line fields
    # are short, so walking forward from the start is cheap and always
    # agrees with text_next_cluster.
    fun text_prev_cluster(self, buf: i64, length: i32, position: i32) -> i32:
        if position <= 0:
            return 0
        start: i32 = 0
        p: i32 = 0
        while p < position and p < length:
            start = p
            p = self.text_next_cluster(buf, length, p)
        return start

    # ---------------------------------------------------------------
    # Words
    # ---------------------------------------------------------------
    # The class of the character starting at `position`: space, word
    # (letters and digits of any script, with their marks) or punctuation.
    fun _text_class_at(self, buf: i64, length: i32, position: i32) -> i32:
        code: Utf8Char = self._text_code_at(buf, length, position)
        return sooryn_char_class(code.codepoint)

    # The start of the word before `position` (Ctrl+Left, Ctrl+Backspace):
    # back over spaces, then over a run of one class.
    fun text_word_left(self, buf: i64, length: i32, position: i32) -> i32:
        p: i32 = position
        q: i32 = 0
        while p > 0:
            q = self.text_prev_cluster(buf, length, p)
            if self._text_class_at(buf, length, q) != SOORYN_CHAR_SPACE:
                break
            p = q
        if p <= 0:
            return 0
        kind: i32 = self._text_class_at(buf, length, self.text_prev_cluster(buf, length, p))
        while p > 0:
            q = self.text_prev_cluster(buf, length, p)
            if self._text_class_at(buf, length, q) != kind:
                break
            p = q
        return p

    # Ctrl+Right, Ctrl+Delete. On Windows: over the rest of this run, then
    # over spaces, to the start of the next word. Elsewhere: over spaces,
    # then over a run, to the end of the word.
    fun text_word_right(self, buf: i64, length: i32, position: i32) -> i32:
        p: i32 = position
        if p >= length:
            return length
        if self.text_word_ends == 1:
            while p < length and self._text_class_at(buf, length, p) == SOORYN_CHAR_SPACE:
                p = self.text_next_cluster(buf, length, p)
            if p >= length:
                return length
            kind: i32 = self._text_class_at(buf, length, p)
            while p < length and self._text_class_at(buf, length, p) == kind:
                p = self.text_next_cluster(buf, length, p)
            return p
        first: i32 = self._text_class_at(buf, length, p)
        if first != SOORYN_CHAR_SPACE:
            while p < length and self._text_class_at(buf, length, p) == first:
                p = self.text_next_cluster(buf, length, p)
        while p < length and self._text_class_at(buf, length, p) == SOORYN_CHAR_SPACE:
            p = self.text_next_cluster(buf, length, p)
        return p

    # Select the run of one class around `position` (a double click).
    fun text_select_word_at(self, buf: i64, length: i32, position: i32):
        if length <= 0:
            self.text_caret = 0
            self.text_anchor = 0
            return
        at: i32 = position
        if at >= length:
            at = self.text_prev_cluster(buf, length, length)
        kind: i32 = self._text_class_at(buf, length, at)
        start: i32 = at
        q: i32 = 0
        while start > 0:
            q = self.text_prev_cluster(buf, length, start)
            if self._text_class_at(buf, length, q) != kind:
                break
            start = q
        end: i32 = at
        while end < length and self._text_class_at(buf, length, end) == kind:
            end = self.text_next_cluster(buf, length, end)
        self.text_anchor = start
        self.text_caret = end

    # Where Backspace deletes back to: one code point, unless that would cut
    # an emoji or a flag apart.
    fun text_backspace_from(self, buf: i64, length: i32, position: i32) -> i32:
        code_start: i32 = self.text_prev_code_point(buf, position)
        code: Utf8Char = self._text_code_at(buf, length, code_start)
        if sooryn_is_mark(code.codepoint) == 1:
            return code_start
        return self.text_prev_cluster(buf, length, position)

    # ---------------------------------------------------------------
    # Mutation
    # ---------------------------------------------------------------
    # Remove [from_index, to_index) and pull the tail down. Returns the new
    # length. Copied byte by byte because the ranges overlap.
    fun text_delete_range(self, buf: i64, length: i32, from_index: i32, to_index: i32) -> i32:
        a: i32 = from_index
        b: i32 = to_index
        if a < 0:
            a = 0
        if b > length:
            b = length
        if b <= a:
            return length
        i: i32 = a
        j: i32 = b
        while j < length:
            Memory.write_i8(buf + (i as i64), Memory.read_i8(buf + (j as i64)))
            i = i + 1
            j = j + 1
        Memory.write_i8(buf + (i as i64), 0 as i8)
        return i

    fun text_delete_selection(self, buf: i64, length: i32) -> i32:
        if self.text_has_selection() == 0:
            return length
        start: i32 = self.text_sel_start()
        result: i32 = self.text_delete_range(buf, length, start, self.text_sel_end())
        self.text_caret = start
        self.text_anchor = start
        return result

    # Insert at the caret, replacing any selection. Truncates at max_len
    # rather than overrunning. Returns the new length.
    fun text_insert(self, buf: i64, max_len: i32, length: i32, value: str) -> i32:
        len_now: i32 = self.text_delete_selection(buf, length)
        add: i32 = Memory.strlen(value) as i32
        room: i32 = max_len - len_now
        if add > room:
            add = room
            # Back off to a character boundary: a field that is nearly full
            # must not keep the first byte of a two-byte letter and become
            # invalid UTF-8.
            while add > 0 and (Memory.read_i8((value as i64) + (add as i64)) & 192) == 128:
                add = add - 1
        if add <= 0:
            return len_now

        # Shift the tail right, back to front, so unread bytes survive.
        i: i32 = len_now
        while i > self.text_caret:
            Memory.write_i8(buf + ((i + add - 1) as i64), Memory.read_i8(buf + ((i - 1) as i64)))
            i = i - 1
        k: i32 = 0
        while k < add:
            Memory.write_i8(buf + ((self.text_caret + k) as i64), Memory.read_i8((value as i64) + (k as i64)))
            k = k + 1

        len_now = len_now + add
        Memory.write_i8(buf + (len_now as i64), 0 as i8)
        self.text_caret = self.text_caret + add
        self.text_anchor = self.text_caret
        return len_now

    # ---------------------------------------------------------------
    # One frame of keyboard editing. Returns 1 if the buffer changed.
    # ---------------------------------------------------------------
    fun text_apply_keys(self, buf: i64, max_len: i32) -> i32:
        length: i32 = self.text_length(buf, max_len)
        changed: i32 = 0
        extend: i32 = self.input_state.shift_down
        words: i32 = self.input_state.ctrl_down
        self.text_history_sync(buf, length)

        # Ctrl+A selects everything; Ctrl+C, Ctrl+X and Ctrl+V copy, cut and
        # paste through the clipboard (clipboard.dlt). The window system
        # delivers them as the control characters 1, 3, 24, 22.
        #
        # Only a control character is a shortcut. Ctrl is also held for
        # AltGr, which types @, { or the euro sign on many keyboards: that is
        # text. Any other Ctrl+letter (Ctrl+Z, Ctrl+B) is no text at all.
        if self.input_state.ctrl_down == 1:
            if Memory.strlen(self.input_state.typed_chars) > 0 and ((Memory.read_i8(self.input_state.typed_chars as i64) as i32) & 255) < 32:
                first: i8 = Memory.read_i8(self.input_state.typed_chars as i64)
                if first == 1 as i8:
                    self.text_select_all(length)
                    self.text_history_break()
                elif first == 3 as i8:
                    self.text_copy_selection(buf)
                elif first == 24 as i8:
                    if self.text_has_selection() == 1:
                        self.text_history_before(buf, length, SOORYN_EDIT_OTHER, 0)
                        self.text_copy_selection(buf)
                        length = self.text_delete_selection(buf, length)
                        self.text_history_after(buf, length)
                        return 1
                elif first == 22 as i8:
                    pasted: str = self.clipboard_line()
                    if Memory.strlen(pasted) > 0 or self.text_has_selection() == 1:
                        self.text_history_before(buf, length, SOORYN_EDIT_OTHER, 0)
                        length = self.text_insert(buf, max_len, length, pasted)
                        self.text_history_after(buf, length)
                        Memory.free(pasted as i64)
                        return 1
                    Memory.free(pasted as i64)
                elif first == 26 as i8:
                    # Ctrl+Z, and Ctrl+Shift+Z redoes.
                    before_undo: i64 = self.hist_sum
                    if self.input_state.shift_down == 1:
                        self.text_redo(buf, max_len, length)
                    else:
                        self.text_undo(buf, max_len, length)
                    if self.hist_sum != before_undo:
                        return 1
                elif first == 25 as i8:
                    before_redo: i64 = self.hist_sum
                    self.text_redo(buf, max_len, length)
                    if self.hist_sum != before_redo:
                        return 1
                return 0

        # Arrows move one character, or with Ctrl one word.
        if self.input_state.left_pressed == 1:
            if words == 1:
                self.text_move_caret(self.text_word_left(buf, length, self.text_caret), extend, length)
            else:
                self.text_move_caret(self.text_prev_cluster(buf, length, self.text_caret), extend, length)
            self.text_history_break()
        if self.input_state.right_pressed == 1:
            if words == 1:
                self.text_move_caret(self.text_word_right(buf, length, self.text_caret), extend, length)
            else:
                self.text_move_caret(self.text_next_cluster(buf, length, self.text_caret), extend, length)
            self.text_history_break()
        if self.input_state.home_pressed == 1:
            self.text_move_caret(0, extend, length)
            self.text_history_break()
        if self.input_state.end_pressed == 1:
            self.text_move_caret(length, extend, length)
            self.text_history_break()

        # Backspace and Delete remove the selection, or one character, or
        # with Ctrl one word.
        if self.input_state.backspace == 1:
            if self.text_has_selection() == 1:
                self.text_history_before(buf, length, SOORYN_EDIT_OTHER, 0)
                length = self.text_delete_selection(buf, length)
                self.text_history_after(buf, length)
                changed = 1
            elif self.text_caret > 0:
                from_index: i32 = self.text_backspace_from(buf, length, self.text_caret)
                kind: i32 = SOORYN_EDIT_BACK
                if words == 1:
                    from_index = self.text_word_left(buf, length, self.text_caret)
                    kind = SOORYN_EDIT_OTHER
                self.text_history_before(buf, length, kind, 0)
                length = self.text_delete_range(buf, length, from_index, self.text_caret)
                self.text_caret = from_index
                self.text_anchor = self.text_caret
                self.text_history_after(buf, length)
                changed = 1

        if self.input_state.delete_pressed == 1:
            if self.text_has_selection() == 1:
                self.text_history_before(buf, length, SOORYN_EDIT_OTHER, 0)
                length = self.text_delete_selection(buf, length)
                self.text_history_after(buf, length)
                changed = 1
            elif self.text_caret < length:
                to_index: i32 = self.text_next_cluster(buf, length, self.text_caret)
                kind_forward: i32 = SOORYN_EDIT_FORWARD
                if words == 1:
                    to_index = self.text_word_right(buf, length, self.text_caret)
                    kind_forward = SOORYN_EDIT_OTHER
                self.text_history_before(buf, length, kind_forward, 0)
                length = self.text_delete_range(buf, length, self.text_caret, to_index)
                self.text_history_after(buf, length)
                changed = 1

        # Typing. Control characters are never text, whatever delivered them.
        typed: i64 = self.input_state.typed_chars as i64
        if Memory.strlen(typed as str) > 0 and sooryn_has_control(typed) == 0:
            kind_typed: i32 = SOORYN_EDIT_TYPE
            if self.text_has_selection() == 1:
                kind_typed = SOORYN_EDIT_OTHER
            # A new word starts a new undo step: a space after something
            # else, or anything after a space.
            starts_word: i32 = 0
            first_space: i32 = 0
            if ((Memory.read_i8(typed) as i32) & 255) == 32:
                first_space = 1
            if self.text_caret > 0:
                before_space: i32 = 0
                if ((Memory.read_i8(buf + ((self.text_caret - 1) as i64)) as i32) & 255) == 32:
                    before_space = 1
                if first_space != before_space:
                    starts_word = first_space
            self.text_history_before(buf, length, kind_typed, starts_word)
            before: i32 = length
            had_selection: i32 = self.text_has_selection()
            length = self.text_insert(buf, max_len, length, typed as str)
            self.text_history_after(buf, length)
            if length != before or had_selection == 1:
                changed = 1

        return changed

# ---------------------------------------------------------------
# Code point classes for text_next_cluster
# ---------------------------------------------------------------
# A combining mark: it sits on the letter before it and is no character of
# its own (Latin accents, Hebrew points, Arabic harakat, and the rest of the
# common combining blocks).
fun sooryn_is_mark(cp: i32) -> i32:
    if cp < 768:
        return 0
    if cp <= 879:
        return 1
    if cp >= 1155 and cp <= 1161:
        return 1
    if cp >= 1425 and cp <= 1469:
        return 1
    if cp == 1471 or cp == 1473 or cp == 1474 or cp == 1476 or cp == 1477 or cp == 1479:
        return 1
    if unicode_is_arabic_mark(cp) == 1:
        return 1
    if cp >= 6832 and cp <= 6911:
        return 1
    if cp >= 7616 and cp <= 7679:
        return 1
    if cp >= 8400 and cp <= 8447:
        return 1
    if cp >= 65056 and cp <= 65071:
        return 1
    if unicode_is_arabic_form_mark(cp) == 1:
        return 1
    return 0

# Two of these make one flag.
fun sooryn_is_regional_indicator(cp: i32) -> i32:
    if cp >= 127462 and cp <= 127487:
        return 1
    return 0

# Anything that belongs to the character before it: marks, the zero-width
# joiner, variation selectors (text or emoji style), skin tones and the tag
# characters of subdivision flags.
fun sooryn_extends_cluster(cp: i32) -> i32:
    if sooryn_is_mark(cp) == 1:
        return 1
    if cp == 8205:
        return 1
    if cp >= 65024 and cp <= 65039:
        return 1
    if cp >= 127995 and cp <= 127999:
        return 1
    if cp >= 917536 and cp <= 917631:
        return 1
    if cp >= 917760 and cp <= 917999:
        return 1
    return 0

# ---------------------------------------------------------------
# Character classes for word movement
# ---------------------------------------------------------------
SOORYN_CHAR_SPACE: i32 = 0
SOORYN_CHAR_WORD: i32 = 1
SOORYN_CHAR_PUNCT: i32 = 2

fun sooryn_is_space(cp: i32) -> i32:
    if cp == 32 or cp == 9 or cp == 160 or cp == 5760 or cp == 8239 or cp == 8287 or cp == 12288:
        return 1
    if cp >= 8192 and cp <= 8202:
        return 1
    return 0

# Letters and digits of any script are word characters, with the marks on
# them; spaces are spaces; the rest of ASCII and the punctuation blocks
# (general punctuation, CJK punctuation, the Arabic comma, semicolon,
# question mark and full stop) are punctuation.
fun sooryn_char_class(cp: i32) -> i32:
    if sooryn_is_space(cp) == 1:
        return SOORYN_CHAR_SPACE
    if cp < 128:
        if cp >= 48 and cp <= 57:
            return SOORYN_CHAR_WORD
        if cp >= 65 and cp <= 90:
            return SOORYN_CHAR_WORD
        if cp >= 97 and cp <= 122:
            return SOORYN_CHAR_WORD
        if cp == 95:
            return SOORYN_CHAR_WORD
        return SOORYN_CHAR_PUNCT
    if sooryn_is_mark(cp) == 1:
        return SOORYN_CHAR_WORD
    if cp >= 161 and cp <= 191:
        return SOORYN_CHAR_PUNCT
    if cp == 215 or cp == 247:
        return SOORYN_CHAR_PUNCT
    if cp >= 8192 and cp <= 8303:
        return SOORYN_CHAR_PUNCT
    if cp >= 12288 and cp <= 12351:
        return SOORYN_CHAR_PUNCT
    if cp == 1548 or cp == 1563 or cp == 1567 or cp == 1748:
        return SOORYN_CHAR_PUNCT
    if cp >= 1642 and cp <= 1645:
        return SOORYN_CHAR_PUNCT
    if cp >= 65281 and cp <= 65295:
        return SOORYN_CHAR_PUNCT
    return SOORYN_CHAR_WORD

# 1 when the NUL-terminated bytes hold a control character.
fun sooryn_has_control(bytes: i64) -> i32:
    i: i64 = 0
    b: i32 = (Memory.read_i8(bytes) as i32) & 255
    while b != 0:
        if b < 32 or b == 127:
            return 1
        i = i + 1
        b = (Memory.read_i8(bytes + i) as i32) & 255
    return 0
