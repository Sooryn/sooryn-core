# ============================
#  Sooryn Widgets
# ============================

attach SoorynApp:
    fun push_commands(self, commands: UIDrawList):
        # UIDrawList may grow its buffers while a widget records commands.
        # Copy the updated value back once so Sooryn keeps the new pointers,
        # counts and text-arena offsets.
        self.commands = commands

    fun text(self, x: i32, y: i32, value: str, color: UIColor):
        commands: UIDrawList = self.commands
        commands.push_text(x, y, value, color)
        self.push_commands(commands)

    # Text is measured through a face built at the physical size, and every
    # widget places it in logical units, so these convert. Without it every
    # centred label and every caret would sit at the wrong offset the moment
    # the display was not at one-to-one.
    fun text_width(self, value: str) -> i32:
        return self.to_logical(self.surface.text_width(value))

    fun text_height(self) -> i32:
        return self.to_logical(self.surface.text_height())

    fun text_advance(self) -> i32:
        return self.to_logical(self.surface.font_advance)

    fun label(self, x: i32, y: i32, value: str):
        self.text(x, y, value, self.theme.text)

    fun muted_label(self, x: i32, y: i32, value: str):
        self.text(x, y, value, self.theme.muted_text)

    # A heading with an accent rule under it. The rule sits a fixed gap below
    # the face's line and is as wide as the words, so it follows whatever
    # face and size is in use instead of a height measured for one font.
    fun title(self, x: i32, y: i32, value: str):
        commands: UIDrawList = self.commands
        commands.push_text(x, y, value, self.theme.text)
        rule_y: i32 = y + self.text_height() + SOORYN_TITLE_GAP
        rule_w: i32 = self.text_width(value)
        if rule_w < SOORYN_TITLE_MIN_RULE:
            rule_w = SOORYN_TITLE_MIN_RULE
        commands.push_line(x, rule_y, x + rule_w, rule_y, self.theme.accent, SOORYN_TITLE_RULE)
        self.push_commands(commands)

    # The height a title takes, rule included: what a layout reserves for it.
    fun title_height(self) -> i32:
        return self.text_height() + SOORYN_TITLE_GAP + SOORYN_TITLE_RULE

    fun panel(self, x: i32, y: i32, width: i32, height: i32):
        commands: UIDrawList = self.commands
        commands.push_fill_rect(x, y, width, height, self.theme.surface)
        commands.push_outline_rect(x, y, width, height, self.theme.border, self.theme.border_width)
        self.push_commands(commands)

    fun rect(self, x: i32, y: i32, width: i32, height: i32, color: UIColor):
        commands: UIDrawList = self.commands
        commands.push_fill_rect(x, y, width, height, color)
        self.push_commands(commands)

    fun outline(self, x: i32, y: i32, width: i32, height: i32, color: UIColor):
        commands: UIDrawList = self.commands
        commands.push_outline_rect(x, y, width, height, color, self.theme.border_width)
        self.push_commands(commands)

    # A soft shadow under a rectangle. Drawn before the thing it falls from,
    # since it is behind it: an immediate-mode frame has no z order beyond the
    # order the calls come in.
    fun shadow(self, x: i32, y: i32, width: i32, height: i32, radius: i32, blur: i32, spread: i32, color: UIColor):
        commands: UIDrawList = self.commands
        commands.push_shadow(x, y, width, height, radius, blur, spread, color)
        self.push_commands(commands)

    # Two colours down or across a rounded rectangle, mixed in light.
    fun gradient(self, x: i32, y: i32, width: i32, height: i32, radius: i32, from_color: UIColor, to_color: UIColor, vertical: i32):
        commands: UIDrawList = self.commands
        commands.push_gradient(x, y, width, height, radius, from_color, to_color, vertical)
        self.push_commands(commands)

    # The shadow a raised surface casts: offset a little downwards, because
    # light in an interface comes from above and a shadow centred under its
    # own box reads as a glow instead.
    fun elevation(self, x: i32, y: i32, width: i32, height: i32, radius: i32, level: i32):
        if level <= 0:
            return
        self.shadow(x, y + level, width, height, radius, level * 3, 0, ui_rgba(0, 0, 0, 90))

    fun separator(self, x: i32, y: i32, width: i32):
        commands: UIDrawList = self.commands
        commands.push_line(x, y, x + width, y, self.theme.border, 1)
        self.push_commands(commands)

    fun button(self, x: i32, y: i32, width: i32, height: i32, label: str) -> i32:
        id: i64 = self.widget_id(110, x, y)
        focused: i32 = self.register_focusable(id)
        mouse: UIMouseState = self.input_state.mouse
        hovered: i32 = self.hit(x, y, width, height)
        fill: UIColor = self.mix_colors(self.theme.accent, self.theme.accent_hover, self.anim_hover(id, hovered))

        commands: UIDrawList = self.commands
        r: i32 = self.theme.corner_radius
        if r > 0:
            commands.push_fill_rounded_rect(x, y, width, height, r, fill)
        else:
            commands.push_fill_rect(x, y, width, height, fill)
        label_w: i32 = self.text_width(label)
        commands.push_text(x + (width - label_w) / 2, y + (height - self.text_height()) / 2, label, self.on_accent_color())
        self.push_commands(commands)
        if focused == 1:
            self.focus_ring_rounded(x, y, width, height, r)

        # Track hover for tooltip support.
        if hovered == 1:
            self.set_hover(id)

        if hovered == 1 and mouse.left_pressed() == 1:
            self.focus_by_pointer(id)
            return 1
        if self.is_activated(id) == 1:
            return 1
        return 0

    fun secondary_button(self, x: i32, y: i32, width: i32, height: i32, label: str) -> i32:
        id: i64 = self.widget_id(111, x, y)
        focused: i32 = self.register_focusable(id)
        mouse: UIMouseState = self.input_state.mouse
        hovered: i32 = self.hit(x, y, width, height)
        fill: UIColor = self.mix_colors(self.theme.surface, self.theme.surface_hover, self.anim_hover(id, hovered))

        commands: UIDrawList = self.commands
        r: i32 = self.theme.corner_radius
        if r > 0:
            commands.push_fill_rounded_rect(x, y, width, height, r, fill)
            commands.push_outline_rounded_rect(x, y, width, height, r, self.control_border_color(), self.theme.border_width)
        else:
            commands.push_fill_rect(x, y, width, height, fill)
            commands.push_outline_rect(x, y, width, height, self.control_border_color(), self.theme.border_width)
        label_w: i32 = self.text_width(label)
        commands.push_text(x + (width - label_w) / 2, y + (height - self.text_height()) / 2, label, self.theme.text)
        self.push_commands(commands)
        if focused == 1:
            self.focus_ring_rounded(x, y, width, height, r)

        # Track hover for tooltip support.
        if hovered == 1:
            self.set_hover(id)

        if hovered == 1 and mouse.left_pressed() == 1:
            self.focus_by_pointer(id)
            return 1
        if self.is_activated(id) == 1:
            return 1
        return 0

    # ======================================================================
    #  Phase-2 widgets
    # ======================================================================

    # ---------------------------------------------------------------
    # Checkbox — 16x16 plain square box with a white tick when checked.
    # Matches the look you get out-of-the-box on web forms / native apps.
    # ---------------------------------------------------------------
    fun checkbox(self, x: i32, y: i32, label: str, value_ptr: i64) -> i32:
        box: i32 = 16
        id: i64 = self.widget_id(100, x, y)
        focused: i32 = self.register_focusable(id)
        # Reading right to left, the box sits on the right with the label
        # running away from it, which is the same relationship mirrored.
        label_w: i32 = self.text_width(label)
        span: i32 = box + 8 + label_w
        box_x: i32 = self.mirror_x(x, span, x, box)
        label_x: i32 = self.mirror_x(x, span, x + box + 8, label_w)
        mouse: UIMouseState = self.input_state.mouse
        hovered: i32 = self.hit(box_x, y, box, box)
        if hovered == 1:
            self.set_hover(id)

        current: i32 = Memory.read_i32(value_ptr)

        commands: UIDrawList = self.commands
        # Box fill: accent when checked, else surface
        checked_t: i32 = self.anim(id, current * 100, 900)
        hover_t: i32 = self.anim_hover(self.mix_id(id, 7), hovered)
        on_fill: UIColor = self.mix_colors(self.theme.accent, self.theme.accent_hover, hover_t)
        fill: UIColor = self.mix_colors(self.theme.surface, on_fill, checked_t)
        off_border: UIColor = self.mix_colors(self.control_border_color(), self.theme.text, hover_t)
        border: UIColor = self.mix_colors(off_border, on_fill, checked_t)
        commands.push_fill_rect(box_x, y, box, box, fill)
        commands.push_outline_rect(box_x, y, box, box, border, self.theme.border_width)

        # Checkmark appears once the box is more filled than not, so it lands
        # with the colour rather than snapping ahead of it.
        if checked_t > 50:
            commands.push_line(box_x + 3, y + 8, box_x + 7, y + 12, self.on_accent_color(), 2)
            commands.push_line(box_x + 7, y + 12, box_x + 13, y + 4, self.on_accent_color(), 2)

        commands.push_text(label_x, y + (box - self.text_height()) / 2, label, self.theme.text)
        self.push_commands(commands)
        if focused == 1:
            self.focus_ring_rounded(box_x, y, box, box, 0)

        activated: i32 = 0
        if hovered == 1 and mouse.left_pressed() == 1:
            self.focus_by_pointer(id)
            activated = 1
        if self.is_activated(id) == 1:
            activated = 1
        if activated == 1:
            if current == 0:
                Memory.write_i32(value_ptr, 1)
            else:
                Memory.write_i32(value_ptr, 0)
            return 1
        return 0

    # ---------------------------------------------------------------
    # Toggle — 40x20 pill with a sliding white knob (iOS/Android style).
    # ---------------------------------------------------------------
    fun toggle(self, x: i32, y: i32, label: str, value_ptr: i64) -> i32:
        w: i32 = 40
        h: i32 = 20
        id: i64 = self.widget_id(101, x, y)
        focused: i32 = self.register_focusable(id)
        toggle_label_w: i32 = self.text_width(label)
        toggle_span: i32 = w + 8 + toggle_label_w
        track_x: i32 = self.mirror_x(x, toggle_span, x, w)
        toggle_label_x: i32 = self.mirror_x(x, toggle_span, x + w + 8, toggle_label_w)
        mouse: UIMouseState = self.input_state.mouse
        hovered: i32 = self.hit(track_x, y, w, h)
        if hovered == 1:
            self.set_hover(id)

        current: i32 = Memory.read_i32(value_ptr)

        slide: i32 = self.anim(id, current * 100, 1000)
        toggle_hover: i32 = self.anim_hover(self.mix_id(id, 7), hovered)
        off_track: UIColor = self.mix_colors(self.track_color(), self.control_border_color(), toggle_hover / 3)
        on_track: UIColor = self.mix_colors(self.theme.accent, self.theme.accent_hover, toggle_hover)
        track_color: UIColor = self.mix_colors(off_track, on_track, slide)

        commands: UIDrawList = self.commands
        commands.push_fill_rounded_rect(track_x, y, w, h, h / 2, track_color)
        # The knob travels from the resting end to the active one, and which
        # end is which turns over with the reading direction.
        knob_r: i32 = (h / 2) - 3
        cy: i32 = y + h / 2
        from_cx: i32 = track_x + h / 2
        to_cx: i32 = track_x + w - h / 2
        if self.is_rtl() == 1:
            from_cx = track_x + w - h / 2
            to_cx = track_x + h / 2
        cx: i32 = from_cx + ((to_cx - from_cx) * slide) / 100
        commands.push_fill_circle(cx, cy, knob_r, self.mix_colors(self.theme.text, self.on_accent_color(), slide))
        commands.push_text(toggle_label_x, y + (h - self.text_height()) / 2, label, self.theme.text)
        self.push_commands(commands)
        if focused == 1:
            self.focus_ring_rounded(track_x, y, w, h, h / 2)

        activated: i32 = 0
        if hovered == 1 and mouse.left_pressed() == 1:
            self.focus_by_pointer(id)
            activated = 1
        if self.is_activated(id) == 1:
            activated = 1
        if activated == 1:
            if current == 0:
                Memory.write_i32(value_ptr, 1)
            else:
                Memory.write_i32(value_ptr, 0)
            return 1
        return 0

    # ---------------------------------------------------------------
    # Slider (horizontal) — returns 1 if value changed this frame.
    # Uses drag state from the input package so smooth dragging works
    # even when the cursor leaves the track briefly.
    # ---------------------------------------------------------------
    fun slider(self, x: i32, y: i32, width: i32, min_v: i32, max_v: i32, value_ptr: i64) -> i32:
        h: i32 = 20
        id: i64 = self.widget_id(102, x, y)
        focused: i32 = self.register_focusable(id)
        mouse: UIMouseState = self.input_state.mouse
        hovered: i32 = self.hit(x, y, width, h)
        if hovered == 1:
            self.set_hover(id)

        v: i32 = Memory.read_i32(value_ptr)
        if v < min_v:
            v = min_v
        if v > max_v:
            v = max_v

        # If user pressed on the track, grab drag ownership
        if hovered == 1 and mouse.left_pressed() == 1:
            self.drag_id = id
            self.focus_by_pointer(id)

        changed: i32 = 0
        # Left/right move the value in twentieths of the range, so a slider
        # is usable without a pointer at any range size.
        nudge: i32 = self.focus_step_x(id)
        if nudge != 0:
            increment: i32 = (max_v - min_v) / 20
            if increment < 1:
                increment = 1
            key_v: i32 = v + nudge * increment
            if key_v < min_v:
                key_v = min_v
            if key_v > max_v:
                key_v = max_v
            if key_v != v:
                Memory.write_i32(value_ptr, key_v)
                v = key_v
                changed = 1
        # While we own the drag, recompute value from current mouse x
        if self.drag_id == id and self.input_state.mouse.left_down == 1:
            rel: i32 = self.input_state.mouse.x - x
            if self.is_rtl() == 1:
                rel = x + width - self.input_state.mouse.x
            if rel < 0:
                rel = 0
            if rel > width:
                rel = width
            new_v: i32 = min_v
            if max_v > min_v:
                new_v = min_v + (rel * (max_v - min_v)) / width
            if new_v != v:
                Memory.write_i32(value_ptr, new_v)
                v = new_v
                changed = 1
        if self.drag_id == id and self.input_state.mouse.left_down == 0:
            self.drag_id = 0

        # --- Render ---
        commands: UIDrawList = self.commands
        track_h: i32 = 6
        track_y: i32 = y + (h - track_h) / 2
        # Track background
        commands.push_fill_rounded_rect(x, track_y, width, track_h, track_h / 2, self.track_color())
        # The filled portion grows from the end the reader starts at.
        fill_w: i32 = 0
        if max_v > min_v:
            fill_w = ((v - min_v) * width) / (max_v - min_v)
        fill_x: i32 = x
        knob_x: i32 = x + fill_w
        if self.is_rtl() == 1:
            fill_x = x + width - fill_w
            knob_x = x + width - fill_w
        if fill_w > 0:
            commands.push_fill_rounded_rect(fill_x, track_y, fill_w, track_h, track_h / 2, self.theme.accent)
        knob_r: i32 = h / 2 - 2
        engaged: i32 = 0
        if hovered == 1 or self.drag_id == id:
            engaged = 1
        knob_color: UIColor = self.mix_colors(self.theme.accent, self.theme.accent_hover, self.anim_hover(id, engaged))
        commands.push_fill_circle(knob_x, y + h / 2, knob_r, knob_color)
        self.push_commands(commands)
        if focused == 1:
            self.focus_ring_rounded(x, y, width, h, h / 2)
        return changed

    # ---------------------------------------------------------------
    # Progress bar — 0..100 percent, flat bar with accent fill.
    # ---------------------------------------------------------------
    fun progress_bar(self, x: i32, y: i32, width: i32, height: i32, percent: i32):
        p: i32 = percent
        if p < 0:
            p = 0
        if p > 100:
            p = 100
        # A rounded track with the done part filled from the end the reader
        # starts at, as a slider is.
        commands: UIDrawList = self.commands
        r: i32 = height / 2
        if r > self.theme.corner_radius:
            r = self.theme.corner_radius
        commands.push_fill_rounded_rect(x, y, width, height, r, self.track_color())
        fill_w: i32 = (width * p) / 100
        if fill_w > 0:
            fill_x: i32 = x
            if self.is_rtl() == 1:
                fill_x = x + width - fill_w
            fill_r: i32 = r
            if fill_r > fill_w / 2:
                fill_r = fill_w / 2
            commands.push_fill_rounded_rect(fill_x, y, fill_w, height, fill_r, self.theme.accent)
        self.push_commands(commands)

    # ---------------------------------------------------------------
    # Tooltip — shows text near the cursor after the hovered widget has
    # been hovered for at least ~30 frames (≈500 ms at 60 fps).
    # Call at end of frame after all widgets have laid out.
    # ---------------------------------------------------------------
    fun tooltip(self, widget_id_hash: i64, text: str):
        if self.hover_id != widget_id_hash:
            return
        if self.hover_frames < 30:
            return
        tx: i32 = self.input_state.mouse.x + 12
        ty: i32 = self.input_state.mouse.y + 12
        w: i32 = self.text_width(text) + 16
        h: i32 = self.text_height() + 12
        commands: UIDrawList = self.commands
        commands.push_fill_rounded_rect(tx, ty, w, h, 4, self.theme.surface_active)
        commands.push_outline_rounded_rect(tx, ty, w, h, 4, self.theme.border, 1)
        commands.push_text(tx + 8, ty + 6, text, self.theme.text)
        self.push_commands(commands)

    # ---------------------------------------------------------------
    # Text input — single-line editable field.
    # caller provides a byte buffer and its max length (excluding the
    # trailing NUL). The widget drains self.input_state.typed_chars into the
    # buffer while focused, and handles backspace. Returns 1 if the
    # buffer was modified this frame.
    # ---------------------------------------------------------------
    fun text_input(self, x: i32, y: i32, width: i32, height: i32, buf: i64, max_len: i32) -> i32:
        id: i64 = self.widget_id(104, x, y)
        # Registered before the click handler so a click can still override
        # whatever Tab decided this frame.
        self.register_focusable(id)
        mouse: UIMouseState = self.input_state.mouse
        hovered: i32 = self.hit(x, y, width, height)
        if hovered == 1:
            self.set_hover(id)
            self.want_cursor(SOORYN_CURSOR_TEXT)

        # Click to focus; click elsewhere to unfocus.
        if mouse.left_pressed() == 1:
            if hovered == 1:
                self.focus_by_pointer(id)
            elif self.focus_id == id:
                self.focus_id = 0

        focused: i32 = 0
        if self.focus_id == id:
            focused = 1
            self.reveal_focused(x, y, width, height)

        length: i32 = self.text_length(buf, max_len)
        changed: i32 = 0

        # The mapping from stored text to drawn glyphs. Everything that has to
        # know where a character ended up on screen reads it.
        self.text_map_build(buf, max_len)
        pad: i32 = 8
        if self.field_text_inset >= 0:
            pad = self.field_text_inset
        text_x: i32 = x + pad
        if self.is_rtl() == 1:
            text_x = x + width - pad - self.text_map_width()

        if focused == 1:
            self.text_claim(id, length)

            # The pointer places the caret and drags out a selection, both in
            # visual space and converted back to the position in the buffer.
            # Shift+click extends the selection; a double click selects a
            # word and a triple click the whole field, as in a browser.
            if hovered == 1 and mouse.left_pressed() == 1:
                at: i32 = self.text_codepoints_to_bytes(buf, max_len, self.text_map_index_at(mouse.x - text_x))
                clicks: i32 = self.count_click(id, mouse.x, mouse.y)
                self.text_history_break()
                if clicks == 2:
                    self.text_select_word_at(buf, length, at)
                elif clicks >= 3:
                    self.text_select_all(length)
                elif self.input_state.shift_down == 1:
                    self.text_caret = at
                    self.text_dragging = 1
                else:
                    self.text_caret = at
                    self.text_anchor = at
                    self.text_dragging = 1
            if self.text_dragging == 1:
                if mouse.left_down == 1:
                    self.text_caret = self.text_codepoints_to_bytes(buf, max_len, self.text_map_index_at(mouse.x - text_x))
                else:
                    self.text_dragging = 0

            changed = self.text_apply_keys(buf, max_len)
            if changed == 1:
                # Editing moved the text under the mapping; rebuild it before
                # anything is drawn from it.
                self.text_map_build(buf, max_len)
                if self.is_rtl() == 1:
                    text_x = x + width - pad - self.text_map_width()
        elif self.text_owner == id:
            # Focus moved on; release the caret so the next input starts clean.
            self.text_owner = 0
            self.text_dragging = 0

        # --- Render ---
        commands: UIDrawList = self.commands
        border_color: UIColor = self.control_border_color()
        if focused == 1:
            border_color = self.theme.accent
        elif hovered == 1:
            border_color = self.mix_colors(self.control_border_color(), self.theme.text, 35)
        r: i32 = self.theme.corner_radius
        if self.field_radius >= 0:
            r = self.field_radius
        if r > height / 2:
            r = height / 2
        commands.push_fill_rounded_rect(x, y, width, height, r, self.theme.surface)
        commands.push_outline_rounded_rect(x, y, width, height, r, border_color, self.theme.border_width)

        # A selection is a range in the stored text, and the glyphs it covers
        # need not be next to each other on screen: a latin word inside an
        # Arabic line is one run, and the Arabic either side of it is another.
        # Paint the runs it actually occupies rather than one rectangle
        # between two ends that may not bound it.
        if focused == 1 and self.text_has_selection() == 1:
            sel_a: i32 = self.text_bytes_to_codepoints(buf, self.text_sel_start())
            sel_b: i32 = self.text_bytes_to_codepoints(buf, self.text_sel_end())
            run_x: i32 = 0 - 1
            run_w: i32 = 0
            cursor: i32 = 0
            v: i32 = 0
            adv: i32 = 0
            source: i32 = 0
            while v < self.text_map_display_count():
                adv = self.text_map_advance(v)
                source = self.text_map_source(v)
                if source >= sel_a and source < sel_b:
                    if run_x < 0:
                        run_x = cursor
                        run_w = 0
                    run_w = run_w + adv
                elif run_x >= 0:
                    commands.push_fill_rect(text_x + run_x, y + 4, run_w, height - 8, self.theme.surface_active)
                    run_x = 0 - 1
                cursor = cursor + adv
                v = v + 1
            if run_x >= 0:
                commands.push_fill_rect(text_x + run_x, y + 4, run_w, height - 8, self.theme.surface_active)

        content: str = buf as str
        commands.push_text(text_x, y + (height - self.text_height()) / 2, content, self.theme.text)

        # The caret sits on the leading edge of the character it precedes,
        # which is the right side of that character in a right-to-left run.
        if focused == 1:
            if (self.frame_counter / 30) & 1 == 0:
                caret_x: i32 = text_x + self.text_map_caret_x(self.text_bytes_to_codepoints(buf, self.text_caret))
                commands.push_fill_rect(caret_x, y + 6, 1, height - 12, self.theme.text)
        self.push_commands(commands)
        return changed

    # ======================================================================
    #  Phase β: panel container with clip stack (responsive)
    # ======================================================================

    # panel_begin: draws a surface panel + pushes a clip region so every
    # widget drawn until panel_end stays inside the panel's inner rect.
    # When the window shrinks, widgets inside the panel visually clip
    # at the panel boundary instead of spilling into neighbours.
    fun panel_begin(self, x: i32, y: i32, width: i32, height: i32):
        commands: UIDrawList = self.commands
        commands.push_fill_rect(x, y, width, height, self.theme.surface)
        commands.push_outline_rect(x, y, width, height, self.theme.border, self.theme.border_width)
        self.push_commands(commands)
        # Inner clip rect leaves room for the border.
        pad: i32 = self.theme.border_width
        if pad < 1:
            pad = 1
        self.push_clip(x + pad, y + pad, width - 2 * pad, height - 2 * pad)

    fun panel_end(self):
        self.pop_clip()

    # ======================================================================
    #  Phase γ: scrollbar + scrollable region + tab bar + dropdown + modal
    #           + drag/drop — all read mouse from self.mouse_* and respect
    #           the active panel clip automatically via the push_clip
    #           commands in the stream.
    # ======================================================================

    # ---------------------------------------------------------------
    # Vertical scrollbar — standalone or embedded in scrollable_region.
    # scroll_ptr stores an i32 pixel offset in [0 .. content_h - view_h].
    # Returns 1 on scroll change, else 0.
    # ---------------------------------------------------------------
    # A standalone scrollbar only takes the wheel over its own track.
    fun scrollbar_vertical(self, x: i32, y: i32, height: i32, view_h: i32, content_h: i32, scroll_ptr: i64) -> i32:
        return self.scrollbar_vertical_area(x, y, height, view_h, content_h, scroll_ptr, x, y, 12, height)

    # Same scrollbar, with the wheel-sensitive rectangle given explicitly.
    # A scrollable region passes its whole area, because a wheel over the
    # content is what a reader actually does; aiming at a 12px column is not.
    fun scrollbar_vertical_area(self, x: i32, y: i32, height: i32, view_h: i32, content_h: i32, scroll_ptr: i64, wheel_x: i32, wheel_y: i32, wheel_w: i32, wheel_h: i32) -> i32:
        w: i32 = 12
        id: i64 = self.widget_id(120, x, y)
        mouse: UIMouseState = self.input_state.mouse
        hovered_track: i32 = self.hit(x, y, w, height)
        if hovered_track == 1:
            self.set_hover(id)
            self.want_cursor(SOORYN_CURSOR_ARROW)

        scroll: i32 = Memory.read_i32(scroll_ptr)
        max_scroll: i32 = content_h - view_h
        if max_scroll < 0:
            max_scroll = 0
        if scroll < 0:
            scroll = 0
        if scroll > max_scroll:
            scroll = max_scroll

        # Thumb height — proportional to visible fraction
        thumb_h: i32 = height
        if content_h > view_h:
            thumb_h = (height * view_h) / content_h
        if thumb_h < 16:
            thumb_h = 16
        thumb_y: i32 = y
        if max_scroll > 0:
            thumb_y = y + ((height - thumb_h) * scroll) / max_scroll

        hovered_thumb: i32 = self.hit(x, thumb_y, w, thumb_h)

        if hovered_thumb == 1 and mouse.left_pressed() == 1:
            self.drag_id = id

        changed: i32 = 0
        if self.drag_id == id and self.input_state.mouse.left_down == 1:
            if max_scroll > 0 and (height - thumb_h) > 0:
                new_thumb_y: i32 = self.input_state.mouse.y - (thumb_h / 2)
                if new_thumb_y < y:
                    new_thumb_y = y
                if new_thumb_y > (y + height - thumb_h):
                    new_thumb_y = y + height - thumb_h
                new_scroll: i32 = ((new_thumb_y - y) * max_scroll) / (height - thumb_h)
                if new_scroll != scroll:
                    scroll = new_scroll
                    changed = 1

        # Mouse wheel over the wheel-sensitive area, not just the track.
        if self.hit(wheel_x, wheel_y, wheel_w, wheel_h) == 1:
            wheel: f32 = self.input_state.mouse.wheel_y
            if wheel != 0.0:
                new_scroll: i32 = scroll - ((wheel * 40.0) as i32)
                if new_scroll < 0:
                    new_scroll = 0
                if new_scroll > max_scroll:
                    new_scroll = max_scroll
                if new_scroll != scroll:
                    scroll = new_scroll
                    changed = 1

        if changed == 1:
            Memory.write_i32(scroll_ptr, scroll)
            if max_scroll > 0:
                thumb_y = y + ((height - thumb_h) * scroll) / max_scroll

        # A thin rounded thumb with no track, as current browsers draw one:
        # it widens and brightens under the pointer and while dragged, so it
        # stays out of the way until it is wanted.
        commands: UIDrawList = self.commands
        active: i32 = 0
        if hovered_track == 1 or self.drag_id == id:
            active = 1
        thumb_w: i32 = 6
        thumb_color: UIColor = self.theme.border
        if active == 1:
            thumb_w = 10
            thumb_color = self.theme.muted_text
        thumb_x: i32 = x + w - thumb_w - 1
        if self.is_rtl() == 1:
            thumb_x = x + 1
        commands.push_fill_rounded_rect(thumb_x, thumb_y + 2, thumb_w, thumb_h - 4, thumb_w / 2, thumb_color)
        self.push_commands(commands)
        return changed

    # ---------------------------------------------------------------
    # Scrollable region — begin/end pair. Pushes a clip to (x, y, w-14, h)
    # and auto-draws a scrollbar on the right edge in scrollable_end.
    # Callers position their content at (cx, cy - scroll_y) themselves.
    # ---------------------------------------------------------------
    fun scrollable_begin(self, x: i32, y: i32, width: i32, height: i32, scroll_ptr: i64, content_h: i32):
        commands: UIDrawList = self.commands
        commands.push_fill_rect(x, y, width, height, self.theme.surface)
        commands.push_outline_rect(x, y, width, height, self.theme.border, self.theme.border_width)
        self.push_commands(commands)
        # Remember params so scrollable_end can draw the scrollbar.
        self.sr_x = x
        self.sr_y = y
        self.sr_w = width
        self.sr_h = height
        self.sr_content_h = content_h
        self.sr_scroll_ptr = scroll_ptr
        # Clip content to the inner area, less the scrollbar column, which
        # sits on the edge the reader's eye returns to.
        content_x: i32 = x + 1
        if self.is_rtl() == 1:
            content_x = x + 13
        self.push_clip(content_x, y + 1, width - 14, height - 2)

    fun scrollable_end(self):
        self.pop_clip()
        bar_x: i32 = self.sr_x + self.sr_w - 12
        if self.is_rtl() == 1:
            bar_x = self.sr_x
        self.scrollbar_vertical_area(bar_x, self.sr_y, self.sr_h, self.sr_h, self.sr_content_h, self.sr_scroll_ptr, self.sr_x, self.sr_y, self.sr_w, self.sr_h)

    # ---------------------------------------------------------------
    # Tab bar — begin/item/end. Items rendered left-to-right with the
    # caller-supplied per-item width. The active tab shows an accent
    # underline.
    # ---------------------------------------------------------------
    fun tab_bar_begin(self, x: i32, y: i32, width: i32, height: i32, active_ptr: i64):
        self.tab_x = x
        self.tab_y = y
        self.tab_h = height
        self.tab_idx = 0
        self.tab_cursor_x = x
        if self.is_rtl() == 1:
            self.tab_cursor_x = x + width
        self.tab_active_ptr = active_ptr
        self.tab_changed = 0
        self.tab_scope = self.widget_id(131, x, y)
        commands: UIDrawList = self.commands
        commands.push_fill_rect(x, y, width, height, self.theme.background)
        commands.push_line(x, y + height - 1, x + width, y + height - 1, self.theme.border, 1)
        self.push_commands(commands)

    fun tab_bar_item(self, label: str, item_width: i32) -> i32:
        active: i32 = Memory.read_i32(self.tab_active_ptr)
        is_active: i32 = 0
        if active == self.tab_idx:
            is_active = 1

        # Keyed by the bar plus this item's index, so a tab keeps its identity
        # when the bar moves or the item widths change.
        self.push_id(self.tab_scope)
        self.push_id_int(self.tab_idx)
        id: i64 = self.widget_id(130, self.tab_cursor_x, self.tab_y)
        self.pop_id()
        self.pop_id()
        item_x: i32 = self.tab_cursor_x
        if self.is_rtl() == 1:
            item_x = self.tab_cursor_x - item_width
        focused: i32 = self.register_focusable(id)
        mouse: UIMouseState = self.input_state.mouse
        hovered: i32 = self.hit(item_x, self.tab_y, item_width, self.tab_h)
        if hovered == 1:
            self.set_hover(id)

        commands: UIDrawList = self.commands
        text_color: UIColor = self.theme.muted_text
        if is_active == 1 or hovered == 1:
            text_color = self.theme.text
        label_w: i32 = self.text_width(label)
        commands.push_text(item_x + (item_width - label_w) / 2, self.tab_y + (self.tab_h - self.text_height()) / 2, label, text_color)
        # The underline grows from the centre, so switching tabs reads as one
        # indicator moving rather than two blinking.
        under_t: i32 = self.anim(self.mix_id(id, 3), is_active * 100, 800)
        if under_t > 0:
            under_w: i32 = (item_width * under_t) / 100
            commands.push_fill_rect(item_x + (item_width - under_w) / 2, self.tab_y + self.tab_h - 3, under_w, 3, self.theme.accent)
        self.push_commands(commands)
        if focused == 1:
            self.focus_ring(item_x, self.tab_y, item_width, self.tab_h)

        changed: i32 = 0
        picked: i32 = 0
        if hovered == 1 and mouse.left_pressed() == 1:
            self.focus_by_pointer(id)
            picked = 1
        if self.is_activated(id) == 1:
            picked = 1
        if picked == 1 and is_active == 0:
            Memory.write_i32(self.tab_active_ptr, self.tab_idx)
            self.tab_changed = 1
            changed = 1

        self.tab_idx = self.tab_idx + 1
        if self.is_rtl() == 1:
            self.tab_cursor_x = self.tab_cursor_x - item_width
        else:
            self.tab_cursor_x = self.tab_cursor_x + item_width
        return changed

    fun tab_bar_end(self) -> i32:
        return self.tab_changed

    # ---------------------------------------------------------------
    # Dropdown — begin/item/end. Closed state is a button-like surface
    # showing the selected label; clicking toggles open. Clicking an
    # item picks + closes.
    # ---------------------------------------------------------------
    fun dropdown_begin(self, x: i32, y: i32, width: i32, height: i32, selected_ptr: i64, selected_label: str) -> i32:
        id: i64 = self.widget_id(140, x, y)
        focused: i32 = self.register_focusable(id)
        self.dd_x = x
        self.dd_y = y
        self.dd_w = width
        self.dd_h = height
        self.dd_selected_ptr = selected_ptr
        self.dd_item_idx = 0
        self.dd_id = id

        mouse: UIMouseState = self.input_state.mouse
        hovered: i32 = self.hit(x, y, width, height)
        if hovered == 1:
            self.set_hover(id)

        # Open state lives in its own slot, so a text input elsewhere can hold
        # keyboard focus while this dropdown is open.
        is_open: i32 = 0
        if self.dd_open_id == id:
            is_open = 1

        toggled: i32 = 0
        if hovered == 1 and mouse.left_pressed() == 1:
            self.focus_by_pointer(id)
            toggled = 1
        if self.is_activated(id) == 1:
            toggled = 1
        if toggled == 1:
            if is_open == 1:
                self.dd_open_id = 0
                is_open = 0
            else:
                self.dd_open_id = id
                is_open = 1
        if is_open == 1 and self.escape_pressed() == 1:
            self.dd_open_id = 0
            is_open = 0

        commands: UIDrawList = self.commands
        fill: UIColor = self.theme.surface
        if hovered == 1:
            fill = self.theme.surface_hover
        border: UIColor = self.control_border_color()
        if is_open == 1:
            border = self.theme.accent
        r: i32 = self.dropdown_radius(height)
        commands.push_fill_rounded_rect(x, y, width, height, r, fill)
        commands.push_outline_rounded_rect(x, y, width, height, r, border, self.theme.border_width)
        label_left: i32 = self.mirror_x(x, width, x + 10, self.text_width(selected_label))
        commands.push_text(label_left, y + (height - self.text_height()) / 2, selected_label, self.theme.text)
        chev_cx: i32 = self.mirror_x(x, width, x + width - 14, 8) + 4
        chev_cy: i32 = y + height / 2
        commands.push_line(chev_cx - 4, chev_cy - 2, chev_cx,     chev_cy + 2, self.theme.muted_text, 1)
        commands.push_line(chev_cx,     chev_cy + 2, chev_cx + 4, chev_cy - 2, self.theme.muted_text, 1)
        self.push_commands(commands)
        if focused == 1:
            self.focus_ring_rounded(x, y, width, height, r)
        # An open list is a popup: above everything, unclipped, and the only
        # thing taking the pointer over its rectangle. Its shadow and its
        # background use the height it had last frame, the one known before
        # the items are drawn. On the frame it opens it is still invisible
        # (it fades in), and its items fill their own rows.
        self.dd_in_layer = 0
        self.dd_has_bg = 0
        if is_open == 1:
            self.enter_layer(SOORYN_LAYER_POPUP)
            self.dd_in_layer = 1
            self.popup_fade_start = self.commands.count
            if self.popup_prev == 1 and self.popup_prev_id == id:
                self.popup_shown_us = self.popup_shown_us + self.frame_delta_us
                list_y: i32 = y + height + SOORYN_MENU_GAP
                list_r: i32 = self.dropdown_radius(height)
                self.elevation(x, list_y, width, self.popup_prev_h, list_r, 4)
                commands = self.commands
                commands.push_fill_rounded_rect(x, list_y, width, self.popup_prev_h, list_r, self.theme.surface)
                self.push_commands(commands)
                self.dd_has_bg = 1
            else:
                self.popup_shown_us = 0
        return is_open

    # The corner of a dropdown's field and list: the theme's, as a text
    # field's is.
    fun dropdown_radius(self, height: i32) -> i32:
        r: i32 = self.theme.corner_radius
        if r < 0:
            r = 0
        if r > height / 2:
            r = height / 2
        return r

    fun dropdown_item(self, label: str) -> i32:
        item_y: i32 = self.dd_y + self.dd_h + SOORYN_MENU_GAP + SOORYN_MENU_PAD + self.dd_item_idx * self.dd_h
        item_x: i32 = self.dd_x + SOORYN_MENU_PAD
        item_w: i32 = self.dd_w - SOORYN_MENU_PAD * 2
        # Keyed by the dropdown plus this item's index rather than by the row
        # position, which moves whenever the dropdown does.
        self.push_id(self.dd_id)
        self.push_id_int(self.dd_item_idx)
        id: i64 = self.widget_id(141, self.dd_x, item_y)
        self.pop_id()
        self.pop_id()
        mouse: UIMouseState = self.input_state.mouse
        hovered: i32 = self.hit(item_x, item_y, item_w, self.dd_h)
        if hovered == 1:
            self.set_hover(id)

        selected: i32 = 0
        if Memory.read_i32(self.dd_selected_ptr) == self.dd_item_idx:
            selected = 1

        # The hovered and the chosen item are rounded highlights inside the
        # list, as in a native menu.
        commands: UIDrawList = self.commands
        if self.dd_has_bg == 0:
            commands.push_fill_rect(self.dd_x, item_y, self.dd_w, self.dd_h, self.theme.surface)
        highlight: UIColor = 0
        if hovered == 1:
            highlight = self.theme.surface_hover
        elif selected == 1:
            highlight = self.theme.surface_active
        if highlight != 0:
            item_r: i32 = self.dropdown_radius(self.dd_h) - 2
            if item_r < 0:
                item_r = 0
            commands.push_fill_rounded_rect(item_x, item_y, item_w, self.dd_h, item_r, highlight)
        item_left: i32 = self.mirror_x(self.dd_x, self.dd_w, self.dd_x + 10, self.text_width(label))
        commands.push_text(item_left, item_y + (self.dd_h - self.text_height()) / 2, label, self.theme.text)
        self.push_commands(commands)

        picked: i32 = 0
        if hovered == 1 and mouse.left_pressed() == 1:
            Memory.write_i32(self.dd_selected_ptr, self.dd_item_idx)
            self.dd_open_id = 0
            picked = 1

        self.dd_item_idx = self.dd_item_idx + 1
        return picked

    fun dropdown_end(self):
        list_y: i32 = self.dd_y + self.dd_h + SOORYN_MENU_GAP
        list_h: i32 = self.dd_item_idx * self.dd_h + SOORYN_MENU_PAD * 2
        if self.dd_item_idx > 0:
            commands: UIDrawList = self.commands
            commands.push_outline_rounded_rect(self.dd_x, list_y, self.dd_w, list_h, self.dropdown_radius(self.dd_h), self.theme.border, self.theme.border_width)
            self.push_commands(commands)
        if self.dd_in_layer == 1:
            self.claim_popup(self.dd_id, self.dd_x, list_y, self.dd_w, list_h)
            # A press anywhere but the field or the list closes it, as a
            # menu on a web page does.
            mouse: UIMouseState = self.input_state.mouse
            if self.dd_open_id == self.dd_id and mouse.left_pressed() == 1:
                on_field: i32 = mouse.is_over_xy(self.dd_x, self.dd_y, self.dd_w, self.dd_h)
                on_list: i32 = mouse.is_over_xy(self.dd_x, list_y, self.dd_w, list_h)
                if on_field == 0 and on_list == 0:
                    self.dd_open_id = 0
            self.fade_commands(self.popup_fade_start, self.fade_amount(self.popup_shown_us, SOORYN_FADE_POPUP_US))
            self.leave_layer()
            self.dd_in_layer = 0

    # ---------------------------------------------------------------
    # Modal — responsive: auto-centers on canvas_w/canvas_h every frame,
    # so it stays centered when the window is resized.
    # ---------------------------------------------------------------
    fun modal_begin(self, width: i32, height: i32, title: str) -> i32:
        if self.md_active == 1:
            return 0
        self.md_active = 1
        if self.modal_prev == 1:
            self.modal_shown_us = self.modal_shown_us + self.frame_delta_us
        else:
            self.modal_shown_us = 0
        self.modal_now = 1
        self.enter_layer(SOORYN_LAYER_MODAL)
        self.modal_fade_start = self.commands.count
        mx: i32 = (self.canvas_w - width) / 2
        my: i32 = (self.canvas_h - height) / 2
        # A raised surface over a dimmed page: the scrim first, so the
        # panel's shadow falls on it rather than under it.
        scrim: UIColor = self.theme.scrim
        if scrim == 0:
            scrim = ui_rgba(0, 0, 0, 128)
        commands: UIDrawList = self.commands
        commands.push_fill_rect(0, 0, self.canvas_w, self.canvas_h, scrim)
        self.push_commands(commands)
        r: i32 = self.theme.corner_radius + 2
        if r > height / 2:
            r = height / 2
        self.elevation(mx, my, width, height, r, 8)
        commands = self.commands
        # Panel
        commands.push_fill_rounded_rect(mx, my, width, height, r, self.theme.surface)
        commands.push_outline_rounded_rect(mx, my, width, height, r, self.theme.border, self.theme.border_width)
        # Title, over a divider
        if Memory.strlen(title) > 0:
            title_left: i32 = self.mirror_x(mx, width, mx + 14, self.text_width(title))
            commands.push_text(title_left, my + (32 - self.text_height()) / 2, title, self.theme.text)
            commands.push_line(mx + 1, my + 32, mx + width - 1, my + 32, self.theme.border, 1)
        self.push_commands(commands)
        return 1

    fun modal_end(self):
        self.md_active = 0
        self.fade_commands(self.modal_fade_start, self.fade_amount(self.modal_shown_us, SOORYN_FADE_MODAL_US))
        self.leave_layer()

    # ---------------------------------------------------------------
    # Drag source / drop target. drag_source records (x, y, w, h,
    # payload) and returns 1 while the user is actively dragging.
    # drop_target highlights while a drag hovers and returns the
    # payload on release. begin_frame clears a stale drag_id if the
    # mouse stopped dragging and no drop_target claimed the payload.
    # ---------------------------------------------------------------
    fun drag_source(self, x: i32, y: i32, width: i32, height: i32, payload: i64) -> i32:
        id: i64 = self.widget_id(150, x, y)
        mouse: UIMouseState = self.input_state.mouse
        hovered: i32 = self.hit(x, y, width, height)
        if hovered == 1:
            self.set_hover(id)
            self.want_cursor(SOORYN_CURSOR_MOVE)
        # Grab drag on press and retain the caller-owned payload until drop.
        if hovered == 1 and mouse.left_pressed() == 1:
            self.drag_id = id
            self.drag_payload = payload
        if self.drag_id == id:
            return 1
        return 0

    fun drop_target(self, x: i32, y: i32, width: i32, height: i32) -> i64:
        if self.drag_id == 0:
            return 0
        mouse: UIMouseState = self.input_state.mouse
        over: i32 = self.hit(x, y, width, height)
        if over == 1:
            commands: UIDrawList = self.commands
            commands.push_outline_rect(x, y, width, height, self.theme.accent, 2)
            self.push_commands(commands)
        if over == 1 and mouse.left_released() == 1:
            payload: i64 = self.drag_payload
            self.drag_id = 0
            self.drag_payload = 0
            return payload
        return 0
