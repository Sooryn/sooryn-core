# ============================
#  Sooryn App
# ============================
# High-level app framework — owns the window + event pump, runs the
# frame loop, delegates drawing to ui via draw_begin/canvas.end.
# On top of that it adds the Phase-β clip stack (panel_begin/end) and
# the Phase-γ widget context fields (tab bar, scrollable, dropdown,
# modal) so the widgets in widgets.dlt have somewhere to store their
# per-frame state.

struct SoorynApp:
    window_handle: i64 = 0
    window_hinstance: i64 = 0
    window_should_close: i32 = 0
    window_resized: i32 = 0
    window_focused: i32 = 1
    window_surface: i64 = 0
    width: i32 = 0
    height: i32 = 0
    valid: i32 = 0

    surface: UISurface = UISurface()
    commands: UIDrawList = UIDrawList()
    input_state: UIInputState = UIInputState()
    theme: SoorynTheme = SoorynTheme()

    # ---- Widget-identity tracking ----
    hover_id: i64 = 0
    focus_id: i64 = 0
    drag_id: i64 = 0
    hover_frames: i32 = 0
    hover_seen: i32 = 0
    frame_counter: i32 = 0

    # ---- Display scale (see scale.dlt) ----
    # width/height are LOGICAL; the surface is physical.
    display_scale: i32 = 100
    physical_width: i32 = 0
    physical_height: i32 = 0
    uses_default_font: i32 = 1
    # 1 while the scale comes from the display (adopt_display_scale), so a
    # window moved to a display of another density follows it. An explicit
    # set_scale_percent turns it off: the application chose.
    follows_display_scale: i32 = 0

    # ---- Layers (see layers.dlt) ----
    overlay: UIDrawList = UIDrawList()
    layer_saved_commands: UIDrawList = UIDrawList()
    layer_depth: i32 = 0
    layer_now: i32 = 0
    layer_saved: i32 = 0
    layer_saved_hit_top: i32 = 0
    modal_now: i32 = 0
    modal_prev: i32 = 0
    popup_now: i32 = 0
    popup_now_id: i64 = 0
    popup_now_x: i32 = 0
    popup_now_y: i32 = 0
    popup_now_w: i32 = 0
    popup_now_h: i32 = 0
    popup_prev: i32 = 0
    popup_prev_id: i64 = 0
    popup_prev_x: i32 = 0
    popup_prev_y: i32 = 0
    popup_prev_w: i32 = 0
    popup_prev_h: i32 = 0
    # How long the open modal and popup have been showing, and where their
    # commands start in the overlay (see layers.dlt, fading in).
    modal_shown_us: i64 = 0
    modal_fade_start: i32 = 0
    popup_shown_us: i64 = 0
    popup_fade_start: i32 = 0
    dd_in_layer: i32 = 0
    # 1 when the open list's background was drawn before its items (its
    # height is known from the previous frame).
    dd_has_bg: i32 = 0

    # ---- Scroll view (see scrollview.dlt) ----
    sv_x: i32 = 0
    sv_y: i32 = 0
    sv_w: i32 = 0
    sv_h: i32 = 0
    sv_state: i64 = 0
    sv_content_w: i32 = 0
    sv_top: i32 = 0
    sv_start: i32 = 0
    # 1 between scroll_view_begin and scroll_view_end.
    sv_open: i32 = 0

    # ---- Hit clip (see hit.dlt) ----
    hit_clips: i64 = 0
    hit_clip_top: i32 = 0
    hit_clip_capacity: i32 = 0

    # ---- Keyboard focus brought into view (see focus.dlt) ----
    focus_reveal: i32 = 0

    # ---- Pointer cursor (see cursor.dlt) ----
    cursor_wanted: i32 = 0
    cursor_current: i32 = 0

    # ---- Clipboard (see clipboard.dlt) ----
    clipboard_bytes: i64 = 0
    clipboard_size: i64 = 0
    # 1 after the system refused a write: Sooryn's copy is newer than it.
    clipboard_local_wins: i32 = 0
    # The default face: SOORYN_FONT_SYSTEM for windowed applications (the
    # platform's interface typeface, as `system-ui` is on the web), and
    # SOORYN_FONT_BUILTIN for headless ones, whose pixels must not depend on
    # the machine running the tests. See system_font.dlt.
    default_font_kind: i32 = 0
    system_font_bytes: i64 = 0
    system_font_size: i64 = 0
    system_font_state: i32 = 0
    system_font_path: str = ""

    # ---- Frame reuse (see frames.dlt) ----
    frame_reuse: i32 = 1
    frame_force_render: i32 = 1
    frame_has_signature: i32 = 0
    frame_last_signature: i64 = 0
    frame_rendered_count: i64 = 0
    frame_reused_count: i64 = 0

    # ---- Reading direction ----
    # Set once for the application. Layouts the app hands out carry it, and
    # widgets that have a side — a checkbox box, a scrollbar, a chevron —
    # mirror themselves.
    direction: i32 = SOORYN_DIR_LTR

    # ---- Identity stack (see identity.dlt) ----
    id_stack: i64 = 0
    id_seqs: i64 = 0
    id_depth: i32 = 0
    id_capacity: i32 = 0

    # ---- Keyboard focus traversal (see focus.dlt) ----
    # Rebuilt every frame from the order widgets register themselves in, so
    # Tab order follows the order the application draws in.
    focus_move: i32 = 0
    focus_take_next: i32 = 0
    focus_wrap_to_last: i32 = 0
    focus_first: i64 = 0
    focus_last: i64 = 0
    focus_prev: i64 = 0
    focus_seen: i32 = 0
    focus_found: i32 = 0
    # Whether focus was last taken by the keyboard. The ring follows this,
    # not focus_id: see focus.dlt.
    focus_visible: i32 = 0
    focus_ring_mode: i32 = 0
    # Shape hooks a shell widget sets before delegating to text_input, so an
    # address bar is the same field wearing a different silhouette rather than
    # a second copy of a hundred lines of caret handling. -1 means the theme's.
    field_radius: i32 = 0 - 1
    field_text_inset: i32 = 0 - 1
    # Document tab strip, between begin and end.
    dt_x: i32 = 0
    dt_y: i32 = 0
    dt_w: i32 = 0
    dt_h: i32 = 0
    dt_count: i32 = 0
    dt_index: i32 = 0
    dt_tab_w: i32 = 0
    dt_new: i32 = 0
    dt_active_ptr: i64 = 0

    # ---- Drag and drop ----
    drag_payload: i64 = 0

    # ---- Text editing (see textedit.dlt) ----
    # Only the focused input needs a caret, so one set of state serves them
    # all; text_owner records which identity it belongs to.
    text_owner: i64 = 0
    text_caret: i32 = 0
    text_anchor: i32 = 0
    text_dragging: i32 = 0
    # Ctrl+Right lands at the start of the next word on Windows and at the
    # end of this one elsewhere, as each platform's own fields do.
    text_word_ends: i32 = 0
    # Clicks in quick succession on one spot: 2 selects a word, 3 the field.
    click_count: i32 = 0
    click_last_us: i64 = 0
    click_last_x: i32 = 0
    click_last_y: i32 = 0
    click_last_id: i64 = 0

    # ---- Undo (see textundo.dlt) ----
    hist_undo: i64 = 0
    hist_redo: i64 = 0
    hist_undo_count: i32 = 0
    hist_redo_count: i32 = 0
    hist_owner: i64 = 0
    hist_kind: i32 = 0
    hist_caret: i32 = 0
    hist_sum: i64 = 0

    # ---- Timed wake-up: the next frame by this time, even with no event
    # (see wake_in). 0 when nothing is waiting.
    wake_at_us: i64 = 0
    # When the pointer arrived on the hovered widget.
    hover_since_us: i64 = 0

    # ---- Tooltip (see tooltip.dlt) ----
    tip_id: i64 = 0
    tip_x: i32 = 0
    tip_y: i32 = 0
    tip_shown_us: i64 = 0
    tip_hidden_id: i64 = 0

    # ---- Key repeat (see keys.dlt) ----
    key_next_us: i64 = 0
    key_wake: i32 = 0

    # ---- Logical-to-visual mapping (see textmap.dlt) ----
    tm_source: i64 = 0
    tm_display: i64 = 0
    tm_sources: i64 = 0
    tm_levels: i64 = 0
    tm_scratch: i64 = 0
    tm_count: i32 = 0
    tm_display_count: i32 = 0
    tm_para: i32 = 0

    # ---- Frame timing and animation (see anim.dlt) ----
    frame_time_us: i64 = 0
    frame_delta_us: i64 = 0
    in_delta_us: i64 = 16666
    anim_keys: i64 = 0
    anim_values: i64 = 0
    anim_touched: i64 = 0
    anim_capacity: i32 = 0
    anim_count: i32 = 0
    anim_active: i32 = 0

    # ---- Managed state (alloc_bool/int/buf) ----
    state_ptrs: i64 = 0
    state_count: i32 = 0
    state_capacity: i32 = 256

    # ---- Begin/end-style widget context ----
    # Tab bar
    tab_x: i32 = 0
    tab_y: i32 = 0
    tab_h: i32 = 0
    tab_idx: i32 = 0
    tab_cursor_x: i32 = 0
    tab_active_ptr: i64 = 0
    tab_changed: i32 = 0
    # Identity of the bar itself, so items are keyed by index rather than by
    # the running cursor position.
    tab_scope: i64 = 0

    # Scrollable region
    sr_x: i32 = 0
    sr_y: i32 = 0
    sr_w: i32 = 0
    sr_h: i32 = 0
    sr_content_h: i32 = 0
    sr_scroll_ptr: i64 = 0

    # Dropdown
    dd_x: i32 = 0
    dd_y: i32 = 0
    dd_w: i32 = 0
    dd_h: i32 = 0
    dd_selected_ptr: i64 = 0
    dd_item_idx: i32 = 0
    dd_id: i64 = 0
    # Which dropdown is open. Kept apart from focus_id so a text input can
    # hold keyboard focus while a dropdown is open.
    dd_open_id: i64 = 0

    # Modal
    md_active: i32 = 0

    # Context menu (see controls.dlt)
    mn_open: i32 = 0
    mn_x: i32 = 0
    mn_y: i32 = 0
    mn_w: i32 = 0
    mn_item_h: i32 = 0
    mn_index: i32 = 0
    mn_open_ptr: i64 = 0

    # Toasts
    ts_text: i64 = 0
    ts_left: i64 = 0
    ts_count: i32 = 0

    # Table (see table.dlt)
    tb_id: i64 = 0
    tb_x: i32 = 0
    tb_y: i32 = 0
    tb_w: i32 = 0
    tb_h: i32 = 0
    tb_row_height: i32 = 0
    tb_row_count: i32 = 0
    tb_header_h: i32 = 0
    tb_scroll_ptr: i64 = 0
    tb_selected_ptr: i64 = 0
    tb_col_widths: i64 = 0
    tb_col_count: i32 = 0
    tb_col_capacity: i32 = 0
    tb_col_cursor: i32 = 0
    tb_row_index: i32 = 0
    tb_row_y: i32 = 0
    tb_first: i32 = 0
    tb_last: i32 = 0
    tb_changed: i32 = 0

    # "Canvas size this frame" — mirrors self.width/height but kept
    # separate so responsive widgets (modal_begin) don't depend on
    # whether the caller has resized since the last sync.
    canvas_w: i32 = 0
    canvas_h: i32 = 0

    # ---- Headless mode ----
    # A headless app owns a surface and runs the full frame loop with no
    # window. Input arrives from the inject_* helpers instead of the OS, so
    # widgets can be driven and asserted on without a display server.
    is_headless: i32 = 0
    in_mouse_x: i32 = 0
    in_mouse_y: i32 = 0
    in_left: i32 = 0
    in_right: i32 = 0
    in_middle: i32 = 0
    in_wheel: f32 = 0.0
    in_chars: str = ""
    in_backspace: i32 = 0
    in_delete: i32 = 0
    in_enter: i32 = 0
    in_tab: i32 = 0
    in_escape: i32 = 0
    in_shift: i32 = 0
    in_ctrl: i32 = 0
    in_alt: i32 = 0
    in_arrow_left: i32 = 0
    in_arrow_right: i32 = 0
    in_arrow_up: i32 = 0
    in_arrow_down: i32 = 0
    in_home: i32 = 0
    in_end: i32 = 0

attach SoorynApp:
    static fun create(title: str, width: i32, height: i32) -> SoorynApp:
        app: SoorynApp = SoorynApp()
        app.use_dark_theme()

        # width and height are the client area in logical units (window 2.0):
        # at 125% a 1120 x 700 request opens 1400 x 875 pixels, as a browser
        # would. The surface is made at the pixels the window actually has.
        if Window.open(title, width, height) == 0:
            return app
        pixel_w: i32 = Window.width()
        pixel_h: i32 = Window.height()
        if pixel_w <= 0 or pixel_h <= 0:
            pixel_w = width
            pixel_h = height

        commands: UIDrawList = ui_draw_list_create(1024)
        if commands.is_valid() == 0:
            Window.shutdown()
            return app

        surface: UISurface = ui_surface_create(pixel_w, pixel_h)
        if surface.is_valid() == 0:
            commands.destroy()
            Window.shutdown()
            return app

        app.window_handle = Window.handle()
        app.window_hinstance = Window.hinstance()
        app.window_should_close = 0
        app.window_resized = 0
        app.window_focused = 1
        app.window_surface = 0
        app.physical_width = pixel_w
        app.physical_height = pixel_h
        app.width = width
        app.height = height
        app.canvas_w = width
        app.canvas_h = height
        app.valid = 1
        app.commands = commands
        app.overlay = ui_draw_list_create(256)
        app.surface = surface
        app.input_state = ui_input_create()
        # Take the display's scale before the first frame: the logical size
        # then comes back as exactly the size the application asked for.
        app.adopt_display_scale()
        app.sync_logical_size()
        # Then the face: the platform's interface font at that size.
        app.default_font_kind = SOORYN_FONT_SYSTEM
        if window_backend() != WINDOW_BACKEND_WIN32:
            app.text_word_ends = 1
        app.apply_default_font()
        return app

    # Offscreen twin of create(). Same surface, same command list, same frame
    # loop — no window, no event pump, no presentation.
    static fun headless(width: i32, height: i32) -> SoorynApp:
        app: SoorynApp = SoorynApp()
        app.use_dark_theme()

        if width <= 0 or height <= 0:
            return app

        commands: UIDrawList = ui_draw_list_create(1024)
        if commands.is_valid() == 0:
            return app

        surface: UISurface = ui_surface_create(width, height)
        if surface.is_valid() == 0:
            commands.destroy()
            return app

        app.is_headless = 1
        app.physical_width = width
        app.physical_height = height
        app.window_handle = 0
        app.window_should_close = 0
        app.window_focused = 1
        app.width = width
        app.height = height
        app.canvas_w = width
        app.canvas_h = height
        app.valid = 1
        app.commands = commands
        app.overlay = ui_draw_list_create(256)
        app.surface = surface
        app.input_state = ui_input_create()
        return app

    fun use_dark_theme(self):
        self.theme = SoorynTheme.dark()

    fun use_light_theme(self):
        self.theme = SoorynTheme.light()

    # Borrow a caller-owned face. Keep it alive until the app is destroyed or
    # another face is selected. Rendering remains owned by ui.
    fun use_font(self, face: FontFace) -> i32:
        # The application owns this one, so Sooryn stops rebuilding a default
        # at every scale change. Size it with font_pixels. use_system_font and
        # use_builtin_font hand the choice back to Sooryn.
        self.uses_default_font = 0
        return self.surface.use_font_face(face)

    fun destroy(self):
        self._free_state()
        self._free_id_stack()
        self._free_table()
        self._free_anim()
        self._free_textmap()
        self._free_toasts()
        self._free_system_font()
        self._free_clipboard()
        self._free_hit_clips()
        self._free_text_history()
        self._free_keys()
        if self.commands.is_valid() == 1:
            self.commands.destroy()
        if self.overlay.is_valid() == 1:
            self.overlay.destroy()
        if self.surface.is_valid() == 1:
            self.surface.destroy()

        if self.window_handle != 0:
            Window.shutdown()

        self.window_handle = 0
        self.valid = 0
        self.width = 0
        self.height = 0

    fun is_valid(self) -> i32:
        return self.valid

    fun should_close(self) -> i32:
        if self.valid == 0:
            return 1
        if self.is_headless == 1:
            return self.window_should_close
        result: i32 = Window.should_close()
        self.window_should_close = result
        return result

    fun running(self) -> i32:
        if self.should_close() == 1:
            return 0
        return 1

    # Ask the frame loop to stop. A window that draws its own close button
    # needs to say so itself; the one the OS draws arrives as an event.
    fun quit(self):
        self.window_should_close = 1
        if self.is_headless == 0:
            Window.request_close()

    fun begin(self) -> i32:
        if self.valid == 0:
            return 0
        if self.is_headless == 1:
            return self.begin_offscreen()
        # Window.wait() returns only on an OS event, and an animation has
        # none. While something is still moving, block with a timeout so the
        # next frame arrives; when nothing is, go fully idle again.
        if self.anim_active > 0:
            Window.wait_timeout(16)
        elif self.wake_at_us > 0:
            # Something is due later (a tooltip's delay): sleep until then,
            # or until an event comes first.
            left_ms: i64 = (self.wake_at_us - TimeOps.time_now_ns() / 1000 + 999) / 1000
            if left_ms < 1:
                left_ms = 1
            Window.wait_timeout(left_ms as i32)
        else:
            Window.wait()
        self.sync_window()
        if self.window_should_close == 1:
            return 0
        self.update_mouse()
        self.begin_frame()
        return 1

    fun begin_poll(self) -> i32:
        if self.valid == 0:
            return 0
        if self.is_headless == 1:
            return self.begin_offscreen()
        Window.poll()
        self.sync_window()
        if self.window_should_close == 1:
            return 0
        self.update_mouse()
        self.begin_frame()
        return 1

    fun begin_timeout(self, timeout_ms: i32) -> i32:
        if self.valid == 0:
            return 0
        if self.is_headless == 1:
            return self.begin_offscreen()
        Window.wait_timeout(timeout_ms)
        self.sync_window()
        if self.window_should_close == 1:
            return 0
        self.update_mouse()
        self.begin_frame()
        return 1

    fun end(self):
        if self.valid == 0:
            return
        if self.hover_seen == 0:
            self.hover_id = 0
            self.hover_frames = 0
        self.resolve_focus_move()
        self.resolve_cursor()
        if self.is_headless == 0:
            # Shown over the client area only; the frame keeps its arrows.
            window_set_cursor_shape(self.cursor_current)
        self.close_layers()
        canvas: DrawCanvas = self.surface.canvas()
        if canvas.is_valid() == 1:
            if self.frame_needs_render() == 1:
                self.commands.render(canvas)
                # Popups and modals, above everything and unclipped.
                canvas.clear_clip()
                self.overlay.render(canvas)
                self.frame_rendered_count = self.frame_rendered_count + 1
            else:
                self.frame_reused_count = self.frame_reused_count + 1
            if self.is_headless == 0:
                window_present_framebuffer(self.window_handle, self.surface.pixels, self.surface.width, self.surface.height, self.surface.pitch)

    fun sync_window(self):
        self.window_handle = Window.handle()
        self.window_hinstance = Window.hinstance()
        self.apply_window_metrics(Window.width(), Window.height(), window_scale_percent())
        self.window_should_close = Window.should_close()
        self.window_focused = Window.focused()
        self.window_surface = 0

    # Take the window's pixel size and its display's scale. Kept apart from
    # the window system so it can be exercised headless.
    #
    # A window moved to a display of another density keeps its logical size
    # (window 2.0) while its pixels change. So a resize is a change in either
    # size: comparing only the logical one left the surface at the old pixel
    # count after such a move.
    fun apply_window_metrics(self, pixel_width: i32, pixel_height: i32, display_scale: i32):
        old_width: i32 = self.width
        old_height: i32 = self.height
        old_pixel_width: i32 = self.physical_width
        old_pixel_height: i32 = self.physical_height
        if self.follows_display_scale == 1 and display_scale > 0 and display_scale != self.display_scale:
            self.set_scale_percent(display_scale)
            self.follows_display_scale = 1
        self.physical_width = pixel_width
        self.physical_height = pixel_height
        self.sync_logical_size()
        self.window_resized = 0
        if self.width != old_width or self.height != old_height or pixel_width != old_pixel_width or pixel_height != old_pixel_height:
            self.window_resized = 1
            if pixel_width > 0 and pixel_height > 0:
                self.surface.resize(pixel_width, pixel_height)

    fun update_mouse(self):
        input_update()
        wheel: f32 = window_consume_wheel_delta()
        chars: str = window_consume_typed_chars()
        point: UIPoint = UIPoint()
        window_client_mouse_position(self.window_handle, point as i64)
        self.input_state.begin_frame(
            self.to_logical(point.x),
            self.to_logical(point.y),
            mouse_pressed(MOUSE_LEFT),
            mouse_pressed(MOUSE_RIGHT),
            mouse_pressed(MOUSE_MIDDLE),
            0.0,
            wheel,
            chars,
            window_consume_backspace()
        )
        now: i64 = TimeOps.time_now_ns() / 1000
        self.key_wake = 0
        self.input_state.set_navigation(
            self.key_repeat(SOORYN_KEY_DELETE, key_pressed(KEY_DELETE), key_just_pressed(KEY_DELETE), now),
            key_just_pressed(KEY_ENTER),
            key_just_pressed(KEY_TAB),
            key_just_pressed(KEY_ESCAPE),
            shift_pressed(),
            ctrl_pressed(),
            alt_pressed()
        )
        self.input_state.set_arrows(
            self.key_repeat(SOORYN_KEY_LEFT, key_pressed(KEY_LEFT), key_just_pressed(KEY_LEFT), now),
            self.key_repeat(SOORYN_KEY_RIGHT, key_pressed(KEY_RIGHT), key_just_pressed(KEY_RIGHT), now),
            self.key_repeat(SOORYN_KEY_UP, key_pressed(KEY_UP), key_just_pressed(KEY_UP), now),
            self.key_repeat(SOORYN_KEY_DOWN, key_pressed(KEY_DOWN), key_just_pressed(KEY_DOWN), now)
        )
        self.input_state.set_edit_keys(
            key_just_pressed(KEY_HOME),
            key_just_pressed(KEY_END)
        )

    fun begin_frame(self):
        self.commands.clear()
        self.commands.push_clear(self.width, self.height, self.theme.background)
        self.frame_counter = self.frame_counter + 1
        self.hover_seen = 0
        self.hit_clip_top = 0
        self.roll_layers()
        self.cursor_wanted = SOORYN_CURSOR_ARROW
        # A held key that repeats needs the frames an animation would.
        self.anim_active = self.key_wake
        self.wake_at_us = 0
        self.begin_timing()
        self.begin_focus_frame()
        # Stale drag cleanup — if a drag ended and no drop_target claimed
        # the payload, reset so a new drag can start cleanly.
        if self.drag_id != 0 and self.input_state.mouse.left_down == 0:
            self.drag_id = 0
            self.drag_payload = 0
        # Modal flag resets too — modal_begin/end are single-frame.
        self.md_active = self.frame_counter - self.frame_counter

    # ---------------------------------------------------------------
    # Widget identity helpers
    # ---------------------------------------------------------------
    # A pushed identity REPLACES position, so the widget keeps its identity
    # wherever layout moves it. With nothing pushed the hash stays derived
    # from position, exactly as before push_id existed.
    fun widget_id(self, type_tag: i32, x: i32, y: i32) -> i64:
        base: i64 = 14695981039346656037 as i64
        prime: i64 = 1099511628211 as i64
        h: i64 = base
        h = (h ^ (type_tag as i64)) * prime
        if self.id_depth > 0:
            # Inside a scope, position is replaced by the scope plus this
            # widget's place in it. The scope alone is not enough: two inputs
            # under one push_id would be the same widget and share a caret.
            h = (h ^ self.current_id()) * prime
            h = (h ^ (self.next_scope_seq() as i64)) * prime
        elif self.sv_open == 1:
            # Inside a scroll view the place is the one in the content, so
            # scrolling does not make a widget a different widget (its focus,
            # its open dropdown, its drag); the view itself keeps two views'
            # contents apart.
            h = (h ^ self.sv_state) * prime
            h = (h ^ (x as i64)) * prime
            h = (h ^ ((y - self.sv_top) as i64)) * prime
        else:
            h = (h ^ (x as i64)) * prime
            h = (h ^ (y as i64)) * prime
        if h == 0:
            return 1
        return h

    # How many presses in a row this one is: within the double-click time
    # (500 ms, the Windows default) and a few pixels of the last, on the same
    # widget. 1, 2, 3, then back to 1.
    fun count_click(self, id: i64, x: i32, y: i32) -> i32:
        now: i64 = self.frame_time_us
        dx: i32 = x - self.click_last_x
        dy: i32 = y - self.click_last_y
        if dx < 0:
            dx = 0 - dx
        if dy < 0:
            dy = 0 - dy
        if id == self.click_last_id and now - self.click_last_us <= 500000 and dx <= 4 and dy <= 4 and self.click_count < 3:
            self.click_count = self.click_count + 1
        else:
            self.click_count = 1
        self.click_last_id = id
        self.click_last_us = now
        self.click_last_x = x
        self.click_last_y = y
        return self.click_count

    fun set_hover(self, id: i64):
        self.want_control_cursor()
        if self.hover_seen == 1 and self.hover_id == id:
            return
        self.hover_seen = 1
        if self.hover_id == id:
            self.hover_frames = self.hover_frames + 1
        else:
            self.hover_id = id
            self.hover_frames = 1
            self.hover_since_us = self.frame_time_us

    # Ask for a frame `us` from now even if nothing happens, for something
    # due later (a tooltip's delay). The earliest request wins.
    fun wake_in(self, us: i64):
        at: i64 = self.frame_time_us + us
        if self.wake_at_us == 0 or at < self.wake_at_us:
            self.wake_at_us = at

    fun is_focused(self, id: i64) -> i32:
        if self.focus_id == id:
            return 1
        return 0

    # Moving focus from application code is a deliberate act of direction,
    # so the ring shows. Use focus_by_pointer for focus that follows a click.
    fun request_focus(self, id: i64):
        self.focus_id = id
        self.focus_visible = 1

    fun release_focus(self):
        self.focus_id = 0

    fun mix_colors(self, a: UIColor, b: UIColor, t_percent: i32) -> UIColor:
        t: i32 = t_percent
        if t < 0:
            t = 0
        if t > 100:
            t = 100
        ab: i32 = a & 255
        ag: i32 = (a >> 8) & 255
        ar: i32 = (a >> 16) & 255
        aa: i32 = (a >> 24) & 255
        bb: i32 = b & 255
        bg: i32 = (b >> 8) & 255
        br: i32 = (b >> 16) & 255
        ba: i32 = (b >> 24) & 255
        rb: i32 = (ab * (100 - t) + bb * t) / 100
        rg: i32 = (ag * (100 - t) + bg * t) / 100
        rr: i32 = (ar * (100 - t) + br * t) / 100
        ra: i32 = (aa * (100 - t) + ba * t) / 100
        return (rb & 255) | ((rg & 255) << 8) | ((rr & 255) << 16) | ((ra & 255) << 24)

    fun set_theme(self, theme: SoorynTheme):
        self.theme = theme

    # ================================================================
    #  Managed state — hides Memory.malloc / Memory.free from user code
    # ================================================================

    fun _track(self, ptr: i64) -> i64:
        if ptr == 0:
            return 0
        if self.state_ptrs == 0:
            self.state_ptrs = Memory.malloc_zeroed((self.state_capacity as i64) * 8)
            if self.state_ptrs == 0:
                Memory.free(ptr)
                return 0
        if self.state_count >= self.state_capacity:
            next_capacity: i32 = self.state_capacity * 2
            if next_capacity < 16:
                next_capacity = 16
            next_ptrs: i64 = Memory.realloc(self.state_ptrs, (next_capacity as i64) * 8)
            if next_ptrs == 0:
                Memory.free(ptr)
                return 0
            self.state_ptrs = next_ptrs
            self.state_capacity = next_capacity
        Memory.write_i64(self.state_ptrs + (self.state_count as i64) * 8, ptr)
        self.state_count = self.state_count + 1
        return ptr

    fun alloc_bool(self, initial: i32) -> i64:
        ptr: i64 = Memory.malloc_zeroed(4)
        if ptr == 0:
            return 0
        Memory.write_i32(ptr, initial)
        return self._track(ptr)

    fun alloc_int(self, initial: i32) -> i64:
        ptr: i64 = Memory.malloc_zeroed(4)
        if ptr == 0:
            return 0
        Memory.write_i32(ptr, initial)
        return self._track(ptr)

    fun alloc_buf(self, capacity: i32) -> i64:
        if capacity < 0:
            return 0
        ptr: i64 = Memory.malloc_zeroed((capacity as i64) + 1)
        return self._track(ptr)

    fun get_bool(self, ptr: i64) -> i32:
        return Memory.read_i32(ptr)

    fun get_int(self, ptr: i64) -> i32:
        return Memory.read_i32(ptr)

    fun set_bool(self, ptr: i64, value: i32):
        Memory.write_i32(ptr, value)

    fun set_int(self, ptr: i64, value: i32):
        Memory.write_i32(ptr, value)

    fun _free_state(self):
        if self.state_ptrs == 0:
            return
        i: i32 = 0
        p: i64 = 0
        while i < self.state_count:
            p = Memory.read_i64(self.state_ptrs + (i as i64) * 8)
            if p != 0:
                Memory.free(p)
            i = i + 1
        Memory.free(self.state_ptrs)
        self.state_ptrs = 0
        self.state_count = 0

    # ================================================================
    #  Clip stack — used by panel_begin/end and scrollable_begin/end
    # ================================================================

    fun push_clip(self, x: i32, y: i32, width: i32, height: i32):
        self.commands.push_clip(x, y, width, height)
        self.push_hit_clip(x, y, width, height)

    fun pop_clip(self):
        self.commands.pop_clip()
        self.pop_hit_clip()

fun sooryn_app_create(title: str, width: i32, height: i32) -> SoorynApp:
    return SoorynApp.create(title, width, height)
