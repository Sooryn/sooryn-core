# ============================
#  Sooryn Theme
# ============================

# Title metrics, in logical units: the gap between a heading's line and its
# accent rule, the rule's thickness, and the shortest rule drawn.
SOORYN_TITLE_GAP: i32 = 4
SOORYN_TITLE_RULE: i32 = 2
SOORYN_TITLE_MIN_RULE: i32 = 24
# An open dropdown list floats a little below its field, with room inside
# around its items, as the menus of current design systems do.
SOORYN_MENU_GAP: i32 = 4
SOORYN_MENU_PAD: i32 = 4

struct SoorynTheme:
    # 1: a hand over clickable controls (most web design systems); 0: the
    # arrow everywhere but text, as plain CSS does for <button>.
    pointer_cursor: i32 = 1
    background: UIColor = 0
    surface: UIColor = 0
    surface_hover: UIColor = 0
    surface_active: UIColor = 0
    text: UIColor = 0
    muted_text: UIColor = 0
    accent: UIColor = 0
    accent_hover: UIColor = 0
    border: UIColor = 0
    danger: UIColor = 0
    spacing: i32 = 12
    padding: i32 = 14
    border_width: i32 = 1
    corner_radius: i32 = 6
    # The focus ring. Thin by default: it marks where the keyboard is, and a
    # marker that has to shout is covering for being in the wrong place.
    # A colour of 0 means unset, and falls back to accent_hover.
    focus_ring_width: i32 = 1
    focus_ring_offset: i32 = 2
    focus_ring_color: UIColor = 0
    # The translucent layer a modal lays over the page, so the page stays
    # visible but recedes. 0 means unset: half-transparent black.
    scrim: UIColor = 0
    # 1: popups and dialogs fade in as they open. 0: they appear at once,
    # for people who ask for reduced motion (CSS prefers-reduced-motion).
    motion: i32 = 1

attach SoorynTheme:
    static fun dark() -> SoorynTheme:
        return SoorynTheme(
            background=ui_rgb(12, 16, 18),
            surface=ui_rgb(24, 31, 35),
            surface_hover=ui_rgb(34, 46, 52),
            surface_active=ui_rgb(43, 59, 66),
            text=ui_rgb(238, 244, 246),
            muted_text=ui_rgb(155, 169, 175),
            accent=ui_rgb(217, 119, 87),
            accent_hover=ui_rgb(229, 141, 110),
            border=ui_rgb(83, 103, 112),
            danger=ui_rgb(245, 91, 96),
            spacing=12,
            padding=14,
            border_width=1,
            corner_radius=6,
            focus_ring_width=1,
            focus_ring_offset=2,
            focus_ring_color=ui_rgb(229, 141, 110),
            scrim=ui_rgba(0, 0, 0, 150)
        )

    static fun light() -> SoorynTheme:
        return SoorynTheme(
            background=ui_rgb(242, 245, 247),
            surface=ui_rgb(255, 255, 255),
            surface_hover=ui_rgb(232, 238, 242),
            surface_active=ui_rgb(218, 227, 232),
            text=ui_rgb(24, 31, 35),
            muted_text=ui_rgb(91, 106, 113),
            accent=ui_rgb(190, 84, 54),
            accent_hover=ui_rgb(213, 104, 72),
            border=ui_rgb(177, 190, 197),
            danger=ui_rgb(204, 48, 57),
            spacing=12,
            padding=14,
            border_width=1,
            corner_radius=6,
            focus_ring_width=1,
            focus_ring_offset=2,
            focus_ring_color=ui_rgb(213, 104, 72),
            scrim=ui_rgba(16, 24, 28, 96)
        )

fun sooryn_theme_dark() -> SoorynTheme:
    return SoorynTheme.dark()

fun sooryn_theme_light() -> SoorynTheme:
    return SoorynTheme.light()
